<!doctype html>
{%- comment -%}
  HA — Landing layout.

  A holding page should not carry the shop it is holding back: there is no
  header, no navigation, no footer, no cart drawer and none of Luxe's
  stylesheets or scripts here. The page is one section, the brand tokens, the
  three typefaces and nothing else, so it loads on a bad connection.

  `content_for_header` stays because Shopify requires it — analytics and the
  storefront's own scripts live in it.

  Used by templates/index.landing.json and templates/page.landing.json.
{%- endcomment -%}
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%}
      Aloha's landing ground, #F3F0E7. Deliberately NOT `settings.ha_page_ground`:
      that is the site-wide #F2EFE9, a cooler cream, and it was tinting the
      browser chrome and the overscroll a shade away from the page. The section
      re-declares html and body from its own Background setting, which is
      authoritative — this is the first-paint value, before that CSS is parsed.
    {%- endcomment -%}
    <meta name="theme-color" content="#F3F0E7">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title | default: shop.name }}</title>
    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% comment %}theme-check-disable AssetPreload{% endcomment %}
    <link rel="preload" as="font" href="{{ 'ha-junicode.woff2' | asset_url }}" type="font/woff2" crossorigin>
    {%- if settings.ha_porter_licensed -%}
      <link rel="preload" as="font" href="{{ 'ha-porter-light.woff2' | asset_url }}" type="font/woff2" crossorigin>
    {%- endif -%}
    <link rel="preload" as="font" href="{{ 'ha-noto-mono-cond-medium.woff2' | asset_url }}" type="font/woff2" crossorigin>
    {% comment %}theme-check-enable AssetPreload{% endcomment %}

    {% render 'ha-tokens' %}
    {% render 'ha-fonts' %}

    {% style %}
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        padding: 0;
        background: #F3F0E7; /* first paint only — the section overrides this */
      }
      img, video { max-width: 100%; }
      .skip-to-content-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10;
        padding: 0.75rem 1rem;
        background: #fff;
        color: #000;
      }
      .skip-to-content-link:focus { left: 0; }
    {% endstyle %}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="ha-landing-body">
    <a class="skip-to-content-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
