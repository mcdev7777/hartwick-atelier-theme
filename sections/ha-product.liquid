        { "type": "url", "id": "link_url", "label": "Link URL (care rows)" },
        { "type": "text", "id": "link_text_2", "label": "Second link text (policy rows: the returns-policy link)" },
        { "type": "page", "id": "page", "label": "Page" }
      ]
    },
    {
      "type": "left_row",
      "name": "Left rail row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sizing information" },
        { "type": "select", "id": "source", "label": "Content comes from", "default": "manual", "options": [
          { "value": "manual", "label": "The text below" }, { "value": "page", "label": "A page" },
          { "value": "policies", "label": "Settings › Policies (shipping + refund)" },
          { "value": "shipping", "label": "Settings › Policies (shipping only)" }, { "value": "refund", "label": "Settings › Policies (refund only)" },
          { "value": "care", "label": "The product's care fields (hartwick.*)" }
        ] },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "text", "id": "link_text", "label": "Link text", "info": "Care rows: with the URL below. Policy rows: the delivery-policy link." },
        { "type": "url", "id": "link_url", "label": "Link URL (care rows)" },
        { "type": "text", "id": "link_text_2", "label": "Second link text (policy rows: the returns-policy link)" },
        { "type": "page", "id": "page", "label": "Page" }
