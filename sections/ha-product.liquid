{%- comment -%}
  Hartwick Atelier — 01 PRODUCT (three columns).
  Built to `04_HA_Product_Desktop_REVISED_EDITABLE.pdf`, Aloha's revised
  wireframe, on a 1440 x 6102 canvas measured at 1:1. Geometry below is that
  drawing, not an estimate:

      left rail   58 -> 380   (322)   sticky
      gap                      42
      media rail  422 -> 1066 (644)   scrolls
      gap                      57
      buy rail   1123 -> 1390 (267)   sticky

  WHY THIS IS A CUSTOM SECTION, when the rest of the build is native.
  Luxe's `main-product` renders `.product-main-top-section` as a flex box with
  exactly TWO children — a media section and an info section. The revised design
  needs THREE columns with two independently sticky rails on either side of a
  scrolling one. No arrangement of CSS gets a flex item's children to straddle a
  sibling, and `display: contents` on the info section would break the very
  stickiness the design is built around. So this is the case CLAUDE.md reserves
  for custom work: "custom sections only where they don't [meet the requirement]".

  WHAT IS STILL SHOPIFY'S OWN. The parts that carry money and inventory are not
  reimplemented — they are Luxe's own snippets, called with the same arguments
  `main-product` uses:

      snippets/product-variant-picker.liquid   variants, availability, swatches
      snippets/buy-buttons.liquid              the product form, cart JS, errors

  Between them they read four settings from their calling section
  (`gallery_aspect_ratio`, `color_scheme`, and two sticky-button flags) and two
  from `block` (`picker_type`, `show_puncuation`, `show_dynamic_checkout`,
  `show_gift_card_recipient`). All six are declared in the schema below and
  `block: section` passes them through, so the snippets behave exactly as they
  do on the native template. Variants, inventory, analytics and checkout are
  untouched.

  TERMINOLOGY (CLAUDE.md). The heading is the permanent numbered Style; the line
  beneath it is the material; the Expression is a labelled row in the buy rail.
  The Lot is customer-facing as a Roman numeral. No Edition number renders
  unless the garment is individually numbered — see snippets/ha-pdp-identity.
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign mf = product.metafields.hartwick

  # ONE SET OF FACTS (Aloha, 16 September 2026). Style, material and
  # Expression resolve through snippets/ha-product-fact — the Hartwick model,
  # then the old site's own records, then the title — so this rail, the Lot
  # record and the Related Works cards can never name a garment differently.
  capture style_name
    render 'ha-product-fact', product: product, field: 'style'
  endcapture
  capture material_line_fallback
    render 'ha-product-fact', product: product, field: 'material'
  endcapture
  capture fact_fibre
    render 'ha-product-fact', product: product, field: 'fibre'
  endcapture
  capture fact_weave
    render 'ha-product-fact', product: product, field: 'weave'
  endcapture
  capture fact_colour
    render 'ha-product-fact', product: product, field: 'colour'
  endcapture
  capture fact_made
    render 'ha-product-fact', product: product, field: 'made_in'
  endcapture
  capture expression
    render 'ha-product-fact', product: product, field: 'expression'
  endcapture
  capture subtitle
    render 'ha-product-fact', product: product, field: 'subtitle'
  endcapture
  capture selector
    render 'ha-product-fact', product: product, field: 'selector'
  endcapture
  capture technique_line
    render 'ha-product-fact', product: product, field: 'material_line'
  endcapture
  assign style_name = style_name | strip | default: product.title
  assign fact_fibre = fact_fibre | strip | default: section.settings.ph_fibre
  # The opening's WEAVE fact is the first fragment only; the further lines of
  # a ";"-separated weave ("black silk weft") belong to the provenance stage.
  assign fact_weave = fact_weave | strip | split: ';' | first | strip | default: section.settings.ph_weave
  assign fact_made = fact_made | strip | default: section.settings.ph_made_in
  assign expression = expression | strip | default: section.settings.ph_expression

  # Aloha's product-copy sheet, tab 01 (16 September): the serif line under
  # the Style is the "Short hero subtitle" — the Expression before its comma
  # ("Handspun Matka Silk"); the record label beneath it is the "Material /
  # technique line" ("HANDSPUN / HANDWOVEN"); the buy rail's Expression row
  # and the COLOUR fact are the "Colour / expression selector" ("Emerald
  # Changeant"). The full Expression stays in the Lot record.
  assign material_line = subtitle | strip
  if material_line == blank
    assign material_line = material_line_fallback | strip | default: section.settings.ph_cloth
  endif
  assign cloth = technique_line | strip
  assign selector = selector | strip
  if selector == blank
    assign selector = fact_colour | strip
  endif
  assign fact_colour = selector | default: section.settings.ph_colour
  assign expression_row = selector | default: expression

  # The Lot, customer-facing as a Roman numeral (Framework v3). With the Edition
  # gone, this is the opening label Aloha asked for: "If the garments are not
  # individually numbered, the opening label should simply show the confirmed Lot
  # information." It renders only when a real Lot exists — never a placeholder.
  assign lot_label = ''
  if mf.lot.value.number_roman != blank
    assign lot_label = 'Lot ' | append: mf.lot.value.number_roman
  endif

  # Key facts render only when present; an absent field leaves no orphaned
  # label and no gap. (Resolved above, with the identity.)

  # Availability is a fact, never a countdown. Aloha, 3 Sep 2026: "We do not
  # want to turn that reality into scarcity language."
  assign ship_date = mf.expected_ship_date | default: section.settings.ph_ship_date

  # Tab 01: "Fit summary" (HIGH WAIST / FULL LENGTH) is the record line under
  # the Fit heading; "Fit & measurements body" is the sentence beneath it.
  assign fit_a = mf.fit | default: section.settings.ph_fit_line_one
  assign fit_body = mf.fit_measurements
  assign fit_b = ''
  if mf.model_height != blank and mf.size_worn != blank
    assign fit_b = 'Model is ' | append: mf.model_height | append: ' and wears ' | append: mf.size_worn | append: '.'
  else
    assign fit_b = section.settings.ph_fit_line_two
  endif

  # Provisional until the Hartwick model itself carries the identity: the old
  # site's title and subtitle are standing in (and the title's legacy name is
  # internal-only per CLAUDE.md), so the notice stays until hartwick.style is
  # linked and hartwick.expression is set.
  assign is_placeholder = false
  if mf.style.value.display_name == blank or mf.expression == blank
    assign is_placeholder = true
  endif

  # The size must be chosen, not assumed (brief: "Before selection, the button
  # asks for a size"). Only on a first, unparameterised view of a multi-size
  # garment that is actually for sale; a ?variant= link, or the section
  # re-render Luxe fetches after a choice, arrives with a selected variant and
  # renders the ordinary form.
  assign size_unset = false
  if section.settings.require_size and product.selected_variant == blank and product.variants.size > 1 and product.available
    assign size_unset = true
  endif

  # The rail shows an excerpt; the full description becomes an accordion row when
  # it is longer than the excerpt, so nothing is lost and nothing is buried.
  # Tab 01 "Hero introduction" is staged in hartwick.hero_introduction while
  # it is draft — Aloha: "Anything marked draft or unconfirmed should remain
  # unpublished", and product.description is live on every theme. When it is
  # present it IS the opening (whole; it is short by design) and the
  # Description row holds the construction sentence (tab 01 "Description
  # accordion" -> hartwick.construction_details). Without it, the old
  # behaviour: an excerpt of product.description, the rest in the row.
  assign hero_intro = ''
  if mf.hero_introduction != blank
    capture hero_intro
      echo mf.hero_introduction | metafield_tag
    endcapture
  endif
  assign full_description = product.description
  if full_description == blank
    assign full_description = section.settings.ph_intro
  endif

  # The old site's DETAILS list (custom.description) belongs with the
  # description. One bullet class is dropped on the way: "Limited Edition /25
  # Lot No. 0624" is scarcity language Aloha removed on 3 September and an
  # unverified run size, so it is filtered here rather than published — the
  # run size publishes from the Lot record once verified.
  # Once the sheet's copy is on the product (hero_introduction), the old
  # site's bullets are superseded and stay out of the row.
  assign details_html = ''
  if product.metafields.custom.description != blank and mf.hero_introduction == blank
    capture raw_details
      echo product.metafields.custom.description | metafield_tag
    endcapture
    assign items = raw_details | split: '<li>'
    for item in items
      if forloop.first
        continue
      endif
      assign item_lc = item | downcase
      if item_lc contains 'limited edition' or item_lc contains 'lot no'
        continue
      endif
      assign item = item | remove: '</ul>' | remove: '</div>' | strip
      assign details_html = details_html | append: '<li>' | append: item
    endfor
    if details_html != blank
      assign details_html = '<ul class="ha-pdp__details">' | append: details_html | append: '</ul>'
    endif
  endif
  assign plain_description = full_description | strip_html | strip
  assign intro_excerpt = plain_description | truncatewords: section.settings.intro_words
  assign description_is_long = false
  if plain_description.size > intro_excerpt.size
    assign description_is_long = true
  endif
  if hero_intro != blank
    assign intro_excerpt = hero_intro
    assign description_is_long = false
  endif
  assign construction_html = ''
  if mf.construction_details != blank
    capture construction_html
      echo mf.construction_details | metafield_tag
    endcapture
  endif
-%}

{%- comment -%}
  Luxe's product form is a set of custom elements — <product-info>, <variant-selects>,
  <product-form> — driven by product-info.js and product-form.js, and styled by
  section-main-product.css / component-price.css. main-product.liquid loads all of
  these itself. This section reuses the same snippets, so it loads the same assets
  and wraps the rail in the same <product-info> the snippets expect as an ancestor
  (variant changes, availability, price and the cart all resolve through it).
{%- endcomment -%}
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Product JSON-LD. Luxe emits `product | structured_data` from
  sections/main-product.liquid, which this section replaced on 3 September —
  so the garment pages had no Product record at all until the 16 September
  audit noticed (Aloha's brief, "Product structured data"). Shopify's own
  output: name, image, offers with price, currency and availability, SKU,
  brand. One record, from theme code only — no app emits a second.
{%- endcomment -%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<product-info
  id="MainProduct-{{ section.id }}"
  class="ha-section ha-pdp{% if size_unset %} ha-pdp--size-unset{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  data-section-id="{{ section.id }}"
  {% if size_unset %}data-ha-size-unset="true" data-ha-size-prompt="{{ section.settings.size_prompt | escape }}"{% endif %}
>
  <div class="ha-pdp__grid">

    {%- comment -%} ---------- LEFT RAIL (sticky) ---------- {%- endcomment -%}
    <div class="ha-pdp__rail ha-pdp__rail--left">
      <div class="ha-pdp__rail-inner">

        {%- if section.settings.show_breadcrumb -%}
          <nav class="ha-pdp__crumbs ha-record" aria-label="Breadcrumb">
            <a href="{{ routes.collections_url }}">{{ section.settings.crumb_root }}</a>
            {%- if collection.title != blank -%}
              <span aria-hidden="true"> / </span>
              <a href="{{ collection.url }}">{{ collection.title }}</a>
            {%- elsif section.settings.crumb_leaf != blank -%}
              <span aria-hidden="true"> / </span>{{ section.settings.crumb_leaf }}
            {%- endif -%}
            {%- if lot_label != blank -%}
              <span aria-hidden="true"> / </span><span class="ha-pdp__lot">{{ lot_label }}</span>
            {%- endif -%}
          </nav>
        {%- elsif lot_label != blank -%}
          <p class="ha-pdp__crumbs ha-record"><span class="ha-pdp__lot">{{ lot_label }}</span></p>
        {%- endif -%}

        {%- comment -%}
          The Style name is set in NARRATE (Junicode), not IDENTIFY (Porter), on
          Aloha's feedback. Porter is subset to A-Z and space, so a Style name is
          the one heading it cannot set: "SHIRT 001" was rendering its letters in
          Porter and its digits in Junicode, which is what made the name look
          like two fonts spliced together. Junicode carries the whole string in
          one face. The heading keeps its uppercase and its size from
          .ha-pdp__title — only the voice changes.
        {%- endcomment -%}
        <h1 class="ha-pdp__title ha-narrate">{{ style_name }}</h1>

        {%- comment -%}
          V2 design: the material as a serif line directly under the Style
          ("Handspun / Silk and Linen"), then the record label only where it
          adds a fact the serif line does not carry.
        {%- endcomment -%}
        {%- if material_line != blank -%}
          <p class="ha-pdp__material ha-narrate">{{ material_line }}</p>
        {%- endif -%}
        {%- if cloth != blank -%}
          <p class="ha-pdp__cloth ha-record">{{ cloth }}</p>
        {%- endif -%}

        {%- comment -%}
          A SHORT opening only. Aloha: when the purchase information runs long the
          visitor can only finish reading it after scrolling past every image, so
          the long copy moves into the accordion rows below. The excerpt is the
          first sentences; the whole description is the "Description" row.
        {%- endcomment -%}
        {%- if intro_excerpt != blank -%}
          <div class="ha-pdp__intro ha-body ha-narrate{% if hero_intro != blank %} ha-pdp__intro--rich{% endif %}">{{ intro_excerpt }}</div>
        {%- endif -%}

        {%- if fact_fibre != blank or fact_weave != blank or fact_colour != blank or fact_made != blank -%}
          <dl class="ha-pdp__facts ha-record">
            {%- if fact_fibre != blank -%}<div><dt>Fibre</dt><dd>{{ fact_fibre }}</dd></div>{%- endif -%}
            {%- if fact_weave != blank -%}<div><dt>Weave</dt><dd>{{ fact_weave }}</dd></div>{%- endif -%}
            {%- if fact_colour != blank -%}<div><dt>Colour</dt><dd>{{ fact_colour }}</dd></div>{%- endif -%}
            {%- if fact_made != blank -%}<div><dt>Made in</dt><dd>{{ fact_made }}</dd></div>{%- endif -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.record_anchor != blank -%}
          <a class="ha-pdp__record-link ha-record" href="{{ section.settings.record_anchor }}">
            {{ section.settings.record_link_text }}
            <span class="ha-pdp__arrow" aria-hidden="true"></span>
          </a>
        {%- endif -%}

        {%- if fit_a != blank or fit_b != blank or fit_body != blank -%}
          <div class="ha-pdp__fit">
            <h2 class="ha-pdp__fit-title ha-narrate">{{ section.settings.fit_heading }}</h2>
            {%- if fit_a != blank -%}<p class="ha-record">{{ fit_a }}</p>{%- endif -%}
            {%- if fit_body != blank -%}<p class="ha-pdp__fit-body ha-body ha-narrate">{{ fit_body | newline_to_br }}</p>{%- endif -%}
            {%- if fit_b != blank -%}<p class="ha-record">{{ fit_b }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Two quiet rows close the left rail. Luxe's own accordion markup and its
          global.js behaviour — see snippets/ha-panel-row.liquid for why this is
          the theme's accordion rather than a second one.
        {%- endcomment -%}
        {%- if description_is_long or details_html != blank or construction_html != blank -%}
          {%- capture description_body -%}
            <div class="ha-pdp__row-body ha-body ha-narrate">
              {{ construction_html }}
              {%- if description_is_long -%}{{ full_description }}{%- endif -%}
              {{ details_html }}
            </div>
          {%- endcapture -%}
          {%- render 'ha-panel-row', id: 'description', title: section.settings.description_row_title, content: description_body -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'left_row' -%}
            {%- capture row_body -%}{%- render 'ha-row-body', block: block, class: 'ha-pdp__row-body', product: product -%}{%- endcapture -%}
            {%- render 'ha-panel-row', id: block.id, title: block.settings.heading, content: row_body -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if is_placeholder -%}
          {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note,
            text: 'Placeholder — Style, cloth and Expression publish from hartwick.* metafields' -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- MEDIA RAIL (scrolls) ---------- {%- endcomment -%}
    <div class="ha-pdp__media">
      {%- if product.media.size > 0 -%}
        <ha-media-rail class="ha-pdp__rail-media" data-count="{{ product.media.size }}">
          {%- comment -%}
            Position markers, one per frame, drawn over the image's right edge
            (V2). They sit BEFORE the frames so they can be sticky: a sticky
            element only holds while its natural position is above the
            viewport, so placed after the frames they would never stick. Real
            buttons, not decoration — the rail is a scroller and this is the
            only way to jump within it without a mouse wheel. Each carries the
            accessible name the brief asks for: "Show image 2 of 3".
          {%- endcomment -%}
          {%- if product.media.size > 1 -%}
            <ol class="ha-pdp__dots" aria-label="{{ section.settings.dots_label }}">
              {%- for media in product.media -%}
                <li>
                  <button
                    type="button"
                    class="ha-pdp__dot"
                    data-frame="{{ section.id }}-frame-{{ forloop.index }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="{{ section.settings.dot_label | replace: '[n]', forloop.index | replace: '[total]', product.media.size }}"
                  ></button>
                </li>
              {%- endfor -%}
            </ol>
          {%- endif -%}

          {%- comment -%}
            Below 990px the frames become one swipeable row (brief, Mobile
            behaviour). A scroll container needs to be reachable and operable
            from the keyboard, so it is a focusable region named for what it
            holds; on desktop the same element is an ordinary block in the
            document flow and the attributes are inert.
          {%- endcomment -%}
          <div class="ha-pdp__frames" role="region" aria-label="{{ section.settings.dots_label }}" tabindex="0" aria-roledescription="carousel">
            {%- for media in product.media -%}
              <figure class="ha-pdp__frame" id="{{ section.id }}-frame-{{ forloop.index }}">
                {%- if media.media_type == 'image' -%}
                  {%- assign frame_loading = 'lazy' -%}
                  {%- if forloop.first -%}{%- assign frame_loading = 'eager' -%}{%- endif -%}
                  {%- assign frame_alt = media.alt | default: style_name -%}
                  {{ media
                    | image_url: width: 1400
                    | image_tag:
                      loading: frame_loading,
                      sizes: '(min-width: 990px) 45vw, 100vw',
                      widths: '480, 720, 960, 1200, 1400',
                      alt: frame_alt,
                      class: 'ha-pdp__img' }}
                  {%- comment -%}
                    CLICK TO ZOOM — Aloha, 5 September 2026.

                    A real <button> layered over the frame rather than a click
                    handler on the <figure>. A figure is not focusable and is
                    not announced as anything you can activate, so a keyboard or
                    screen-reader visitor would have had no way in at all. The
                    button carries the accessible name; the picture stays
                    decorative to it.

                    `hidden` until the script wires it, so a visitor without
                    JavaScript is never shown a control that cannot do anything.
                    `data-zoom-src` is the full-resolution source, requested only
                    when the dialog actually opens — the rail keeps loading its
                    own modest 1400px version.
                  {%- endcomment -%}
                  <button
                    type="button"
                    class="ha-pdp__zoom"
                    data-zoom-src="{{ media | image_url: width: 2400 }}"
                    aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index | default: 'Zoom image' }}"
                    hidden
                  ></button>
                {%- else -%}
                  {{ media | media_tag: image_size: '1400x' }}
                {%- endif -%}
              </figure>
            {%- endfor -%}
          </div>

          {%- comment -%}
            The readout the V2 design draws at the foot of the frame — "01 / 03"
            and "Scroll". Sticky to the bottom of the viewport while the rail
            is taller than the screen, so the count is always in view; the
            hint disappears after the first scroll (script) and is never shown
            for a single image.
          {%- endcomment -%}
          {%- if product.media.size > 1 -%}
            <div class="ha-pdp__readout ha-record" aria-hidden="true">
              <span class="ha-pdp__count" data-count-of="{{ product.media.size }}">01 / {{ product.media.size | prepend: '0' | slice: -2, 2 }}</span>
              <span class="ha-pdp__scroll-hint">{{ section.settings.scroll_hint }}<span class="ha-pdp__scroll-arrow" aria-hidden="true">&darr;</span></span>
            </div>
            <p class="visually-hidden" aria-live="polite" data-count-live></p>
          {%- endif -%}
        </ha-media-rail>
        <script src="{{ 'ha-pdp-zoom.js' | asset_url }}" defer></script>
      {%- else -%}
        {%- render 'ha-figure', label: section.settings.ph_media_label, class: 'ha-pdp__frame ha-pdp__frame--empty' -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- BUY RAIL (sticky) ---------- {%- endcomment -%}
    <div class="ha-pdp__rail ha-pdp__rail--buy{% if section.settings.enable_sticky_buttons %} sticky-buy-buttons sticky-buy-buttons--border-{{ section.settings.sticky_buttons_border }}{% endif %}">
      <div class="ha-pdp__rail-inner">

        <div class="ha-pdp__price">
          {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: '' -%}
        </div>
        {%- if section.settings.tax_note != blank -%}
          <p class="ha-pdp__tax ha-record">{{ section.settings.tax_note }}</p>
        {%- endif -%}

        {%- if expression_row != blank -%}
          <div class="ha-pdp__field">
            <p class="ha-pdp__field-label ha-record">{{ section.settings.expression_label }}</p>
            <p class="ha-pdp__field-value ha-pdp__field-value--lead ha-narrate">{{ expression_row }}</p>
          </div>
        {%- endif -%}

        <div class="ha-pdp__size">
          {%- if section.settings.size_guide_page != blank -%}
            <a class="ha-pdp__size-guide ha-record" href="{{ section.settings.size_guide_page.url }}">Size guide</a>
          {%- endif -%}
          {%- render 'product-variant-picker',
            product: product,
            block: section,
            product_form_id: product_form_id,
            labels: true,
            pill_threshold: 12,
            pill_options_display: 'all',
            show_variant_images: false,
            swatches: false -%}
        </div>

        {%- comment -%}
          Availability — tab 05: "Use current inventory, not old lot
          availability." With no note recorded, the line is live: "Select a
          size" until one is chosen, then the chosen size's state (script,
          from Luxe's own variantChange event). A recorded note — "Through
          The Register" — takes precedence, because that is a statement of
          route, not of stock.
        {%- endcomment -%}
        {%- if mf.availability_note != blank -%}
          <div class="ha-pdp__field">
            <p class="ha-pdp__field-label ha-record">{{ section.settings.availability_label }}</p>
            <p class="ha-pdp__field-value ha-pdp__field-value--lead ha-record">{{ mf.availability_note }}</p>
          </div>
        {%- elsif section.settings.show_availability -%}
          {%- liquid
            assign v0 = product.selected_or_first_available_variant
            assign live_text = section.settings.availability_in_stock
            if size_unset
              assign live_text = section.settings.size_prompt
            elsif v0.available == false
              assign live_text = section.settings.availability_sold_out
            endif
          -%}
          <div class="ha-pdp__field">
            <p class="ha-pdp__field-label ha-record">{{ section.settings.availability_label }}</p>
            <p class="ha-pdp__field-value ha-pdp__field-value--lead ha-record" data-ha-availability data-in-stock="{{ section.settings.availability_in_stock | escape }}" data-sold-out="{{ section.settings.availability_sold_out | escape }}">{{ live_text }}</p>
          </div>
        {%- endif -%}

        {%- if ship_date != blank -%}
          <div class="ha-pdp__field">
            <p class="ha-pdp__field-label ha-record">{{ section.settings.dispatch_label }}</p>
            <p class="ha-pdp__field-value ha-record">{{ ship_date }}</p>
          </div>
        {%- endif -%}

        {%- render 'buy-buttons',
          block: section,
          product: product,
          product_form_id: product_form_id,
          section_id: section.id,
          style: 'solid',
          show_payment_methods: false,
          show_pickup_availability: false -%}

        {%- render 'ha-appointment', text: section.settings.appointment_text -%}

        {%- comment -%}
          The longer purchase terms are a row, not a paragraph, so the buy rail
          stays short enough to read without scrolling the media.
        {%- endcomment -%}
        {%- comment -%}
          "The delivery accordion shows the same approved policy as the service
          section below" (brief). A row set to the policies source reads
          Settings > Policies — the same text checkout shows — so there is one
          copy of the delivery terms on the site, not two.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'buy_row' -%}
            {%- capture buy_body -%}{%- render 'ha-row-body', block: block, class: 'ha-pdp__row-body', product: product -%}{%- endcapture -%}
            {%- render 'ha-panel-row', id: block.id, title: block.settings.heading, content: buy_body -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.payment_note != blank -%}
          <p class="ha-pdp__payment ha-record">{{ section.settings.payment_note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</product-info>
{%- if size_unset or section.settings.show_availability -%}<script src="{{ 'ha-pdp-size.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "HA — Product",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Three columns: a sticky left rail, a scrolling media rail and a sticky buy rail. Built to Wireframe 04 (revised)." },

    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "crumb_root", "label": "Root label", "default": "Collection" },
    { "type": "text", "id": "crumb_leaf", "label": "Fallback leaf", "default": "Apparel", "info": "Used when the visitor did not arrive from a collection." },

    { "type": "header", "content": "Left rail" },
    { "type": "richtext", "id": "ph_intro", "label": "Description fallback", "info": "Used only when the product has no description.", "default": "<p><em>Placeholder — the product description publishes from Shopify.</em></p>" },
    { "type": "text", "id": "fit_heading", "label": "Fit heading", "default": "Fit & Measurements" },
    { "type": "text", "id": "record_link_text", "label": "Record link text", "default": "View the material record" },
    { "type": "text", "id": "record_anchor", "label": "Record link target", "default": "#the-material-record" },
    { "type": "range", "id": "intro_words", "label": "Description excerpt length", "min": 12, "max": 80, "step": 2, "unit": "wd", "default": 32, "info": "The rail shows this many words; the full description opens in a row beneath." },
    { "type": "text", "id": "description_row_title", "label": "Description row title", "default": "Description" },

    { "type": "header", "content": "Buy rail" },
    { "type": "text", "id": "expression_label", "label": "Expression label", "default": "Expression" },
    { "type": "text", "id": "availability_label", "label": "Availability label", "default": "Availability" },
    { "type": "checkbox", "id": "show_availability", "label": "Show live availability", "default": true, "info": "“Select a size”, then the chosen size's state. A recorded hartwick.availability_note always wins." },
    { "type": "text", "id": "availability_in_stock", "label": "Available reads", "default": "Available" },
    { "type": "text", "id": "availability_sold_out", "label": "Sold out reads", "default": "Sold out" },
    { "type": "text", "id": "dispatch_label", "label": "Dispatch label", "default": "Expected dispatch" },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "Duties and taxes shown at checkout" },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page" },
    { "type": "text", "id": "appointment_text", "label": "Appointment link", "default": "Request a Private Appointment" },
    { "type": "textarea", "id": "payment_note", "label": "Payment note", "default": "Full payment is taken when the order is placed. Delivery timing is shown before checkout." },

    { "type": "header", "content": "Media" },
    { "type": "text", "id": "ph_media_label", "label": "Placeholder label", "default": "Product image / centre media rail" },
    { "type": "text", "id": "dots_label", "label": "Gallery accessible name", "default": "Product images" },
    { "type": "text", "id": "dot_label", "label": "Marker accessible name", "default": "Show image [n] of [total]", "info": "[n] and [total] are filled in." },
    { "type": "text", "id": "scroll_hint", "label": "Scroll hint", "default": "Scroll to explore", "info": "Shown beside the image count until the visitor scrolls." },
    { "type": "header", "content": "Size selection" },
    { "type": "checkbox", "id": "require_size", "label": "Ask for a size before Add to Bag", "default": true, "info": "Brief, 16 Sept: “Before selection, the button asks for a size.” Off = Shopify's default, the first available size preselected." },
    { "type": "text", "id": "size_prompt", "label": "Button reads, until a size is chosen", "default": "Select a size" },

    { "type": "header", "content": "Placeholder content", "info": "Used per field, only where the product has no value. Wireframe copy — provenance is unverified and must not go live as fact (risk R7)." },
    { "type": "text", "id": "ph_cloth", "label": "Cloth line", "default": "Handspun silk & linen" },
    { "type": "text", "id": "ph_fibre", "label": "Fibre", "default": "Silk / linen" },
    { "type": "text", "id": "ph_weave", "label": "Weave", "default": "Handwoven" },
    { "type": "text", "id": "ph_colour", "label": "Colour", "default": "Natural / undyed" },
    { "type": "text", "id": "ph_made_in", "label": "Made in", "default": "[Confirm garment origin]", "info": "Shown only while hartwick.place_of_construction is empty. Tab 02: “Do not infer garment origin from textile origin.”" },
    { "type": "text", "id": "ph_expression", "label": "Expression", "default": "Natural / Undyed" },
    { "type": "text", "id": "ph_availability", "label": "Availability", "default": "Made in small quantities" },
    { "type": "text", "id": "ph_ship_date", "label": "Expected to ship" },
    { "type": "text", "id": "ph_fit_line_one", "label": "Fit line 1", "default": "Relaxed through the body." },
    { "type": "text", "id": "ph_fit_line_two", "label": "Fit line 2" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true },

    { "type": "header", "content": "Shopify form (read by Luxe's own snippets)", "info": "These are the settings snippets/product-variant-picker.liquid and snippets/buy-buttons.liquid read from their calling section. Leave them alone unless the form misbehaves." },
    { "type": "select", "id": "picker_type", "label": "Size picker", "options": [{ "value": "button", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdown" }], "default": "button" },
    { "type": "checkbox", "id": "show_puncuation", "label": "Punctuation after labels", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Dynamic checkout buttons", "default": false },
    { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Gift card recipient form", "default": false },
    { "type": "checkbox", "id": "enable_sticky_buttons", "label": "Sticky Add to Bag (mobile)", "default": true, "info": "Required by the mobile brief. Pins the buy form to the bottom of the viewport below 990px." },
    { "type": "checkbox", "id": "sticky_buttons_border", "label": "Hairline above the sticky bar", "default": true },
    { "type": "checkbox", "id": "enable_sticky_buttons_desktop", "label": "Sticky Add to Bag (desktop)", "default": false },
    { "type": "select", "id": "gallery_aspect_ratio", "label": "Variant image ratio", "options": [{ "value": "portrait-4x6", "label": "Portrait 2:3" }, { "value": "portrait", "label": "Portrait 4:5" }, { "value": "square", "label": "Square" }], "default": "portrait-4x6" }
  ],
  "blocks": [
    {
      "type": "buy_row",
      "name": "Buy rail row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery & Returns" },
        { "type": "select", "id": "source", "label": "Content comes from", "default": "manual", "options": [
