{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — THE REGISTER PAGE 02 / JOIN THE CORRESPONDENCE.
  Aloha's Hartwick_The_Register artboard, 21 September 2026; the card
  remade from her FinalHartwick_The_Register artboard, 24 September.

  Two columns on the page ground. Left: an eyebrow, the heading, a lead line
  and the Register card — her photograph of a sheet of the Atelier's dyed
  paper in a glassine envelope, with THE REGISTER and "Correspondence from
  the Atelier." laid on the dyed sheet as live text, and the thread and seal
  she drew across the envelope (a dark disc with the House symbol). Every
  position is a percentage of the photograph, measured off the artboard (the
  envelope 301 wide on 1440). Right: an
  eyebrow, "Join The Register.", one paragraph and the form — email, first
  name (optional), the consent line, a privacy note and the wine button.

  The form is The Register's form — the same submission as the homepage band
  (sections/ha-register.liquid): Shopify's customer form in the markup, posted
  to Klaviyo by assets/ha-klaviyo-form.js with the company and list ids from
  theme settings, and `register_source` recording that this placement was the
  one that worked. `novalidate` and `data-nocaptcha` for the same reasons as
  there. With JS off it is Shopify's own form and the sync catches it.

  1 October 2026 (Aloha, "the updated register page"): the card is a new
  photograph — a yellow card in a mauve glassine envelope — with "The story
  continues beyond the piece." printed on the yellow card (a pull line; the
  lead under the heading is emptied in the template, since the line moved
  onto the card) and her square gold wax seal on the envelope's front (an
  image, `seal_image`; the drawn thread and dark disc are retired). The
  heading "Join The Register" drops its full stop; the button is her olive
  (`button_style`: olive), the wine one stays available.

  Terminology (CLAUDE.md): The Register is public and free to join; every
  call to action here says Join The Register. The Dispatch is what it
  receives. Nothing on this form touches The Circle.

  Consent: the artboard's own line — "I would like to receive The Dispatch and
  Release notices." — with "Read our Privacy Policy. Unsubscribe at any time."
  beneath. Express consent under CASL, never pre-ticked; whether the box's
  wording must itself name Hartwick Atelier is for Christina.
{%- endcomment -%}

<section id="{{ section.settings.anchor | default: 'join-the-register' }}" class="ha-home ha-reg ha-reg-page ha-reg-join ha-grain-block" aria-labelledby="ha-reg-join-title">
  <div class="ha-wrap">
    {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: "Placeholder — copy transcribed from Aloha's Register artboard, for her to confirm." -%}

    <div class="ha-reg__grid">
      <div class="ha-reg__lead">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ha-home__eyebrow ha-identify">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ha-home__heading ha-narrate">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <div class="ha-home__lead ha-narrate" style="margin-top: 2.4rem;">{{ section.settings.lead }}</div>
        {%- endif -%}
        {%- if section.settings.show_card -%}
          <figure class="ha-reg__card ha-reg-note">
            {%- if section.settings.card_image -%}
              {{
                section.settings.card_image
                | image_url: width: 1200
                | image_tag: class: 'ha-reg-note__img', loading: 'lazy', sizes: '(min-width: 990px) 30rem, 70vw', widths: '400, 600, 800, 1000, 1200', alt: section.settings.card_alt
              }}
            {%- else -%}
              <span class="ha-figure ha-figure--empty ha-reg-note__img"><span class="ha-figure__label ha-record">01 / The Register card</span></span>
            {%- endif -%}
            {%- if section.settings.card_title != blank or section.settings.card_line != blank -%}
              <figcaption class="ha-reg-note__words">
                {%- if section.settings.card_title != blank -%}
                  <span class="ha-reg-note__title ha-narrate">{{ section.settings.card_title }}</span>
                {%- endif -%}
                {%- if section.settings.card_line != blank -%}
                  <span class="ha-reg-note__line ha-narrate ha-pull">{{ section.settings.card_line }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
            {%- if section.settings.show_seal and section.settings.seal_image -%}
              {{ section.settings.seal_image | image_url: width: 320 | image_tag: class: 'ha-reg-note__wax', loading: 'lazy', sizes: '5rem', widths: '120, 200, 320', alt: '' }}
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>

      <div class="ha-reg__aside">
        {%- if section.settings.aside_eyebrow != blank -%}
          <p class="ha-home__eyebrow ha-identify">{{ section.settings.aside_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.aside_heading != blank -%}
          <h2 id="ha-reg-join-title" class="ha-home__heading ha-narrate">{{ section.settings.aside_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="ha-home__prose ha-narrate" style="margin-top: 1.6rem;">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.show_form -%}
          {%- form 'customer',
            class: 'ha-reg-form',
            novalidate: 'novalidate',
            data-nocaptcha: 'true',
            data-ha-klaviyo: '',
            data-company-id: settings.ha_klaviyo_company_id,
            data-list-id: settings.ha_klaviyo_register_list,
            data-source: section.settings.register_source,
            data-msg-invalid: section.settings.msg_invalid,
            data-msg-consent: section.settings.msg_consent,
            data-msg-submitting: section.settings.msg_submitting,
            data-msg-success: section.settings.msg_success,
            data-msg-error: section.settings.msg_error
          -%}
            <input type="hidden" name="contact[tags]" value="{{ section.settings.contact_tag | escape }}">

            <p class="ha-reg-form__message ha-record" data-ha-form-status tabindex="-1" role="status" aria-live="polite" hidden></p>

            {%- render 'ha-honeypot', id: 'RegisterJoinHp', suffix: section.id -%}

            <div class="ha-reg-form__field">
              <label class="ha-reg-form__label ha-record" for="HaRegJoinEmail--{{ section.id }}">{{ section.settings.label_email }}</label>
              <input
                id="HaRegJoinEmail--{{ section.id }}"
                class="ha-reg-form__input ha-narrate"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                aria-required="true"
                {% if form.errors %}aria-invalid="true" aria-describedby="HaRegJoinError--{{ section.id }}"{% elsif form.posted_successfully? %}aria-describedby="HaRegJoinSuccess--{{ section.id }}"{% endif %}
                required
              >
            </div>

            {%- if section.settings.show_first_name -%}
              <div class="ha-reg-form__field">
                <label class="ha-reg-form__label ha-record" for="HaRegJoinFirst--{{ section.id }}">{{ section.settings.label_first }}</label>
                <input id="HaRegJoinFirst--{{ section.id }}" class="ha-reg-form__input ha-narrate" type="text" name="contact[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
              </div>
            {%- endif -%}

            {%- if section.settings.consent_text != blank -%}
              <label class="ha-reg-form__check ha-record">
                <input type="checkbox" data-ha-consent required aria-required="true">
                <span>{{ section.settings.consent_text }}</span>
              </label>
            {%- endif -%}

            {%- if section.settings.privacy_note != blank -%}
              <div class="ha-reg-form__note ha-record">{{ section.settings.privacy_note }}</div>
            {%- endif -%}

            <button type="submit" class="ha-reg-form__submit{% if section.settings.button_style == 'olive' %} ha-reg-form__submit--olive{% endif %} ha-record ha-grain-block" name="commit">{{ section.settings.submit_text }}</button>

            {%- if form.errors -%}
              <p class="ha-reg-form__message ha-reg-form__message--server ha-record is-error" id="HaRegJoinError--{{ section.id }}" role="alert" style="margin-top: 1.6rem;">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="ha-reg-form__message ha-reg-form__message--server ha-record" id="HaRegJoinSuccess--{{ section.id }}" tabindex="-1" role="status" style="margin-top: 1.6rem;">
                {{- section.settings.msg_success -}}
              </p>
            {%- endif -%}
          {%- endform -%}
          <script src="{{ 'ha-klaviyo-form.js' | asset_url }}" defer></script>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HA — Register: Join",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "join-the-register", "info": "Links elsewhere point at #this." },
    { "type": "header", "content": "Left column" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the correspondence" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Cloth. People.\nThe work in between.", "info": "A new line breaks the heading there, as the artboard does." },
    { "type": "richtext", "id": "lead", "label": "Lead", "default": "<p>The story continues beyond the piece.</p>" },
    { "type": "checkbox", "id": "show_card", "label": "Show the Register card", "default": true },
    { "type": "image_picker", "id": "card_image", "label": "Card photograph", "info": "Aloha's dyed sheet in a glassine envelope, cut out on a transparent ground. The words, thread and seal sit on it at fixed positions: a different photograph needs them re-measured." },
    { "type": "text", "id": "card_alt", "label": "Card alt text", "default": "A sheet of the Atelier's grey dyed paper in a glassine envelope, tied with a thread and sealed with the House symbol" },
    { "type": "text", "id": "card_title", "label": "Card title", "info": "Optional. Set in capitals by the style." },
    { "type": "text", "id": "card_line", "label": "Card line", "default": "The story continues beyond the piece.", "info": "On the yellow card, as a pull line." },
    { "type": "checkbox", "id": "show_seal", "label": "Wax seal", "default": true },
    { "type": "image_picker", "id": "seal_image", "label": "Wax seal picture", "info": "Aloha's square gold seal (HA_REGISTER_SEAL_SQUARE.png), on the envelope's front." },
    { "type": "header", "content": "Right column" },
    { "type": "text", "id": "aside_eyebrow", "label": "Eyebrow", "default": "The Dispatch / Email correspondence" },
    { "type": "text", "id": "aside_heading", "label": "Heading", "default": "Join The Register" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Notes on materials, Masters and work in progress. Sent when there is something worth sharing.</p>" },
    { "type": "header", "content": "The form" },
    { "type": "checkbox", "id": "show_form", "label": "Show the form", "default": true, "info": "Posts to Klaviyo's Register list, as the homepage band does." },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email address *" },
    { "type": "checkbox", "id": "show_first_name", "label": "Ask for a first name", "default": true },
    { "type": "text", "id": "label_first", "label": "First name label", "default": "First name (optional)" },
    {
      "type": "richtext", "id": "consent_text", "label": "Consent line",
      "default": "<p>I would like to receive The Dispatch and Release notices.</p>",
      "info": "Required to submit and never pre-ticked. Express consent under CASL; Christina to confirm the wording."
    },
    {
      "type": "richtext", "id": "privacy_note", "label": "Note beneath",
      "default": "<p>Read our <a href=\"/policies/privacy-policy\">Privacy Policy</a>. Unsubscribe at any time.</p>"
    },
    { "type": "text", "id": "submit_text", "label": "Button", "default": "Join The Register" },
    { "type": "select", "id": "button_style", "label": "Button colour", "options": [{ "value": "olive", "label": "Olive (Aloha, 1 October)" }, { "value": "wine", "label": "Wine" }], "default": "olive" },
    { "type": "text", "id": "contact_tag", "label": "Customer tag (no-JS fallback only)", "default": "the-register" },
    {
      "type": "text", "id": "register_source", "label": "Klaviyo source", "default": "register_page",
      "info": "Recorded on the profile as register_source, one value per placement."
    },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "msg_invalid", "label": "Invalid email", "default": "Please enter a valid email address." },
    { "type": "text", "id": "msg_consent", "label": "Consent not ticked", "default": "Please tick the box to join." },
    { "type": "text", "id": "msg_submitting", "label": "While sending", "default": "One moment…" },
    { "type": "text", "id": "msg_success", "label": "Success", "default": "Thank you. A confirmation is on its way — one click and you are on The Register.", "info": "The list is double opt-in, so the success message must send them to their inbox." },
    { "type": "text", "id": "msg_error", "label": "Service error", "default": "That did not go through. Please try again, or write to contact@hartwickatelier.com." },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "presets": [{ "name": "HA — Register: Join" }]
}
{% endschema %}
