{%- comment -%}
  Hartwick Atelier — THE ORIGIN (Wireframe 04, revised).

  Redesigned to the revised wireframe: a heading on the left, and on the right a
  connected route of numbered steps — origin/region → workshop → master → dye →
  atelier — rather than the earlier three-image composition. "Show the journey
  without pretending one garment comes from one simple place. Publish only
  verified information."

  Each step is a block: a label (WEAVING) and a sub-label (MASTER / PLACE). The
  circles are joined by a hairline on desktop; on mobile the route stacks and the
  hairline runs vertically. No image is asserted, and nothing is invented — the
  sub-labels stay "PUBLISH VERIFIED …" until real provenance exists (risk R7).

  Product page only. Data may later come from hartwick.process_steps / origin
  metaobjects; until then the blocks render.
{%- endcomment -%}

<section class="ha-section ha-originroute{% unless section.settings.field == 'page' or section.settings.field == blank %} ha-section--field-{{ section.settings.field }}{% endunless %}">
  <div class="ha-wrap ha-originroute__grid">
    <div class="ha-originroute__lead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ha-eyebrow ha-record">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ha-display ha-narrate ha-originroute__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="ha-originroute__intro ha-body ha-narrate">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <ol class="ha-originroute__steps" role="list">
      {%- for block in section.blocks -%}
        <li class="ha-originroute__step" {{ block.shopify_attributes }}>
          <span class="ha-originroute__marker" aria-hidden="true">
            <span class="ha-originroute__num ha-record">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </span>
          <span class="ha-originroute__label ha-record">{{ block.settings.label }}</span>
          {%- if block.settings.sublabel != blank -%}
            <span class="ha-originroute__sub ha-record">{{ block.settings.sublabel }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "HA — The Origin",
  "tag": "section",
  "class": "ha-section-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "field", "label": "Field colour", "default": "page", "options": [
      { "value": "page", "label": "Page ground" }, { "value": "white", "label": "White" },
      { "value": "peat", "label": "Peat (dark)" }, { "value": "clay", "label": "Clay" },
      { "value": "botanical", "label": "Botanical" }, { "value": "slate", "label": "Slate (dark)" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Origin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A route through material and place." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Show the journey without pretending one garment comes from one simple place. Publish only verified information.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Fibre" },
        { "type": "text", "id": "sublabel", "label": "Sub-label", "default": "Origin / region" }
      ]
    }
  ],
  "presets": [{
    "name": "Hartwick — The Origin",
    "blocks": [
      { "type": "step", "settings": { "label": "Fibre", "sublabel": "Origin / region" } },
      { "type": "step", "settings": { "label": "Spinning", "sublabel": "Workshop / place" } },
      { "type": "step", "settings": { "label": "Weaving", "sublabel": "Master / place" } },
      { "type": "step", "settings": { "label": "Dyeing", "sublabel": "Method / place" } },
      { "type": "step", "settings": { "label": "Construction", "sublabel": "Atelier / place" } }
    ]
  }]
}
{% endschema %}
