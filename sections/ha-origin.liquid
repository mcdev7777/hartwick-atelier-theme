{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — 08 THE ORIGIN.
  Wireframe (03) PRODUCT PAGE §08; mobile brief §6.

  "This section connects the garment to place without interrupting the purchase
  route. I use one larger raw-fibre or landscape image beside two smaller images
  for natural dye and the loom." — mobile brief §6.

  The asymmetric composition is held in CSS grid and keeps its proportions at
  every width, so Shopify crops through the theme image container rather than
  needing a hand-cut file per breakpoint (brief §6, and the STABLE LAYOUT
  requirement in §12 — every figure reserves its ratio before the image loads).

  Data: the `origin` metaobject reached through hartwick.place_of_weaving, and
  the `dye` metaobject through hartwick.dye (docs/data-model.md §2).
  Place of weaving is preferred because this section is about where the cloth
  comes from; construction is covered by the Material Record's "Made by" row.

  ⚠️ Provenance is unverified for most rows in the naming spreadsheet
  ([pending Chanchal verification], risk R7). Nothing here is invented — with no
  metaobject bound, the wireframe's own copy renders, clearly marked provisional.
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.hartwick

  assign origin = mf.place_of_weaving.value
  if origin == blank
    assign origin = mf.place_of_construction.value
  endif
  if origin == blank
    assign origin = mf.place_of_dyeing.value
  endif

  assign dye = mf.dye.value

  # Place line: "Rajasthan, India"
  assign place_line = section.settings.ph_place
  if origin.place != blank
    assign place_line = origin.place
    if origin.country != blank
      assign place_line = place_line | append: ', ' | append: origin.country
    endif
  endif

  assign body = origin.why_here | default: section.settings.intro
  assign practice = origin.local_practice

  assign fig_fibre = section.settings.image_fibre | default: origin.landscape_image
  assign fig_dye = section.settings.image_dye | default: dye.image
  assign fig_loom = section.settings.image_loom

  assign has_real_data = false
  if origin != blank
    assign has_real_data = true
  endif
-%}

<section class="ha-section ha-origin">
  <div class="ha-wrap">
    <div class="ha-origin__grid">
      <div class="ha-origin__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ha-eyebrow ha-record">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ha-display ha-narrate ha-origin__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if place_line != blank -%}
          <p class="ha-origin__place ha-record">{{ place_line }}</p>
        {%- endif -%}

        {%- if body != blank -%}
          <div class="ha-origin__body ha-body ha-narrate">{{ body }}</div>
        {%- endif -%}

        {%- if practice != blank -%}
          <div class="ha-origin__body ha-body ha-narrate">{{ practice }}</div>
        {%- endif -%}

        {%- unless has_real_data -%}
          {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note -%}
        {%- endunless -%}

        {%- if section.settings.link_text != blank -%}
          <p class="ha-origin__foot">
            <a class="ha-link ha-identify" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_text }}</a>
          </p>
        {%- endif -%}
      </div>

      <div class="ha-origin__media">
        {%- render 'ha-figure',
          image: fig_fibre,
          label: section.settings.label_fibre,
          class: 'ha-origin__figure ha-origin__figure--fibre',
          sizes: '(min-width: 990px) 27vw, 50vw',
          alt: section.settings.alt_fibre
        -%}
        {%- render 'ha-figure',
          image: fig_dye,
          label: section.settings.label_dye,
          class: 'ha-origin__figure ha-origin__figure--dye',
          sizes: '(min-width: 990px) 27vw, 50vw',
          alt: section.settings.alt_dye
        -%}
        {%- render 'ha-figure',
          image: fig_loom,
          label: section.settings.label_loom,
          class: 'ha-origin__figure ha-origin__figure--loom',
          sizes: '(min-width: 990px) 27vw, 50vw',
          alt: section.settings.alt_loom
        -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HA — The Origin",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Origin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in place, made by hand." },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>From seed to garment, each step is held by human hands and local knowledge. The materials are few, the processes patient, and the results never identical.</p>",
      "info": "Used only while no origin metaobject is bound. The record's own 'why_here' replaces it."
    },
    { "type": "text", "id": "ph_place", "label": "Placeholder place", "default": "Rajasthan, India" },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "01 — Raw fibre", "info": "The large image. Falls back to the origin record's landscape image." },
    { "type": "image_picker", "id": "image_fibre", "label": "Image" },
    { "type": "text", "id": "alt_fibre", "label": "Alt text" },
    { "type": "text", "id": "label_fibre", "label": "Placeholder label", "default": "01 / Raw fibre" },
    { "type": "header", "content": "02 — Natural dye", "info": "Falls back to the dye record's image." },
    { "type": "image_picker", "id": "image_dye", "label": "Image" },
    { "type": "text", "id": "alt_dye", "label": "Alt text" },
    { "type": "text", "id": "label_dye", "label": "Placeholder label", "default": "02 / Natural dye" },
    { "type": "header", "content": "03 — The loom" },
    { "type": "image_picker", "id": "image_loom", "label": "Image" },
    { "type": "text", "id": "alt_loom", "label": "Alt text" },
    { "type": "text", "id": "label_loom", "label": "Placeholder label", "default": "03 / The loom" },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "presets": [{ "name": "Hartwick — The Origin" }]
}
{% endschema %}
