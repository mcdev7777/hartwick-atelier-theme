{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — ABOUT 01, the opening.
  Aloha's FINAL_ABOUTPAGE_DESKTOP_EDITABLE.pdf, 25 September 2026: her pink
  paper photograph from the top of the page (the menu is transparent over
  it — header setting "Transparent on these pages" includes `about`), her
  glassine envelope of photographs laid across it on the diagonal, and the
  page title with its line in white at the lower left.

  The envelope is her aboutx.png turned 67.25° anticlockwise (the angle of
  the placement matrix in the PDF), cut to the same box the PDF gives it:
  -72 / -193, 1441 wide, on a 1440 × 900 band. It spills past the band's
  edges there too; the band clips it.
{%- endcomment -%}

<section class="ha-abo{% if section.settings.grain %} ha-page-grain ha-grain-block{% endif %}"{% if section.settings.paper %} style="--ha-abo-paper: url({{ section.settings.paper | image_url: width: 2880 }});"{% endif %} aria-labelledby="ha-abo-title">
  <div class="ha-abo__stage">
    {%- if section.settings.envelope -%}
      {{- section.settings.envelope | image_url: width: 2600 | image_tag:
        class: 'ha-abo__envelope',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '(min-width: 750px) 100vw, 150vw',
        widths: '750, 1100, 1500, 2000, 2600',
        alt: section.settings.envelope_alt -}}
    {%- endif -%}
    <div class="ha-abo__text">
      {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: "Placeholder — copy transcribed from Aloha's About artboard (25 Sep), for her to confirm." -%}
      <h1 id="ha-abo-title" class="ha-abo__title ha-label">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.subline != blank -%}
        <p class="ha-abo__sub ha-narrate">{{ section.settings.subline | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HA — About: Opening",
  "tag": "section",
  "class": "ha-abo-section",
  "settings": [
    { "type": "paragraph", "content": "Aloha's About artboard, 25 September 2026: pink paper, the envelope of photographs, the title in white." },
    { "type": "image_picker", "id": "paper", "label": "Paper (background)" },
    { "type": "checkbox", "id": "grain", "label": "Grain", "default": true, "info": "Page grain strength (Theme settings). The envelope stays above it." },
    { "type": "header", "content": "Envelope" },
    { "type": "image_picker", "id": "envelope", "label": "Envelope picture", "info": "Transparent PNG, already turned to its angle." },
    { "type": "text", "id": "envelope_alt", "label": "Alt text", "default": "A glassine envelope holding old photographs" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Page title", "default": "About Hartwick" },
    { "type": "textarea", "id": "subline", "label": "Line beneath", "default": "A house shaped by material, place and\nthe knowledge of the people who make." },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "presets": [{ "name": "HA — About: Opening" }]
}
{% endschema %}
