{%- comment -%}
  Hartwick Atelier — FRIENDS & FAMILY FEEDBACK. 1 October 2026.

  Christina asked for a quick review form for friends and family, sent as a
  link from Klaviyo. No button or popup: the email's link opens this page,
  which is a Shopify page (handle `friends-and-family`, template `feedback`)
  kept out of every menu and hidden from search engines (`seo.hidden`).

  WHAT REACHES KLAVIYO. assets/ha-klaviyo-form.js in EVENT MODE records
  `Friends & Family Feedback` on the person's profile. It is not a list
  subscription and records no marketing consent, so nobody joins The Register
  by answering. The event carries:
    · one property per question, named by the question's "Klaviyo key"
      (a 1–5 scale arrives as "4", ticked choices as a list);
    · `answers` — [{ question, answer }, …] in page order;
    · `answers_text` — the same as plain lines, "Question: answer", so the
      alert email can print everything with one tag and does not need
      editing when a question is added or reworded;
    · `full_name` / `first_name` / `last_name` when a name is given, and
      `register_source` (the Klaviyo source setting).
  A Klaviyo flow triggered on that metric sends Angela an internal alert.

  THE QUESTIONS ARE BLOCKS — scale, choice, written — so they are edited in
  the theme editor, not in code. Until Christina's own questions arrive the
  template carries clearly marked placeholders.

  Styles: assets/ha-feedback.css, loaded here (one page only).
{%- endcomment -%}

{{ 'ha-feedback.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id | replace: '-', '_'
-%}

<section class="ha-home ha-feedback ha-grain-block" aria-labelledby="FeedbackTitle-{{ sid }}">
  <div class="ha-wrap">
    {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: section.settings.placeholder_text -%}

    <div class="ha-feedback__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ha-home__eyebrow ha-identify">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="FeedbackTitle-{{ sid }}" class="ha-home__heading ha-narrate">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="ha-home__prose ha-feedback__intro ha-narrate">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- form 'customer',
        class: 'ha-reg-form ha-feedback__form',
        id: 'Feedback',
        novalidate: 'novalidate',
        data-nocaptcha: 'true',
        data-ha-klaviyo: '',
        data-company-id: settings.ha_klaviyo_company_id,
        data-klaviyo-event: section.settings.event_name,
        data-source: section.settings.register_source,
        data-msg-invalid: section.settings.msg_invalid,
        data-msg-required: section.settings.msg_required,
        data-msg-submitting: section.settings.msg_submitting,
        data-msg-success: section.settings.msg_success,
        data-msg-error: section.settings.msg_error
      -%}
        {%- comment -%} Only used if the script never loads: Shopify keeps the email under its own tag. {%- endcomment -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.contact_tag | escape }}">

        <p class="ha-reg-form__message ha-record" data-ha-form-status tabindex="-1" role="status" aria-live="polite" hidden></p>

        {%- if form.posted_successfully? -%}
          <p class="ha-reg-form__message ha-reg-form__message--server ha-record" tabindex="-1" autofocus>{{ section.settings.msg_success }}</p>
        {%- elsif form.errors -%}
          <p class="ha-reg-form__message ha-reg-form__message--server ha-record is-error" tabindex="-1" autofocus>{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="ha-feedback__who">
          <div class="ha-reg-form__field">
            <label class="ha-reg-form__label ha-record" for="FeedbackName-{{ sid }}">{{ section.settings.label_name }}</label>
            <input id="FeedbackName-{{ sid }}" class="ha-reg-form__input ha-narrate" type="text" name="contact[first_name]" autocomplete="name" data-klaviyo-prop="full_name">
          </div>
          <div class="ha-reg-form__field">
            <label class="ha-reg-form__label ha-record" for="FeedbackEmail-{{ sid }}">{{ section.settings.label_email }}</label>
            <input id="FeedbackEmail-{{ sid }}" class="ha-reg-form__input ha-narrate" type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" aria-required="true" required>
          </div>
        </div>

        {%- for block in section.blocks -%}
          {%- liquid
            assign q = block.settings.question
            if q == blank
              continue
            endif
            assign key = block.settings.key | default: q | handleize | replace: '-', '_' | truncate: 40, ''
            assign qid = 'Fq-' | append: sid | append: '-' | append: block.id
            assign mark = ''
            if block.settings.required
              assign mark = ' *'
            endif
          -%}

          {%- case block.type -%}
            {%- when 'scale' -%}
              <fieldset class="ha-reg-form__field ha-feedback__q ha-feedback__q--scale" data-ha-question="{{ q | escape }}"{% if block.settings.required %} data-ha-required{% endif %} {{ block.shopify_attributes }}>
                <legend class="ha-reg-form__label ha-record">{{ q }}{{ mark }}</legend>
                <div class="ha-feedback__scale">
                  {%- for n in (1..5) -%}
                    <label class="ha-feedback__point">
                      <input type="radio" name="{{ qid }}" value="{{ n }}" data-klaviyo-prop="{{ key }}">
                      <span class="ha-record">{{ n }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                {%- if block.settings.low_label != blank or block.settings.high_label != blank -%}
                  <p class="ha-feedback__ends ha-record" aria-hidden="true">
                    <span>1 · {{ block.settings.low_label }}</span>
                    <span>5 · {{ block.settings.high_label }}</span>
                  </p>
                {%- endif -%}
              </fieldset>

            {%- when 'choice' -%}
              {%- liquid
                assign kind = 'radio'
                if block.settings.multiple
                  assign kind = 'checkbox'
                endif
                assign options = block.settings.options | newline_to_br | split: '<br />'
              -%}
              <fieldset class="ha-reg-form__field ha-feedback__q ha-feedback__q--choice" data-ha-question="{{ q | escape }}"{% if block.settings.required %} data-ha-required{% endif %} {{ block.shopify_attributes }}>
                <legend class="ha-reg-form__label ha-record">{{ q }}{{ mark }}</legend>
                <div class="ha-feedback__options">
                  {%- for option in options -%}
                    {%- assign label = option | strip -%}
                    {%- if label == blank -%}{%- continue -%}{%- endif -%}
                    <label class="ha-reg-form__check ha-record">
                      <input type="{{ kind }}" name="{{ qid }}" value="{{ label | escape }}" data-klaviyo-prop="{{ key }}">
                      <span>{{ label }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>

            {%- when 'text' -%}
              <div class="ha-reg-form__field ha-feedback__q ha-feedback__q--text" data-ha-question="{{ q | escape }}"{% if block.settings.required %} data-ha-required{% endif %} {{ block.shopify_attributes }}>
                <label class="ha-reg-form__label ha-record" for="{{ qid }}">{{ q }}{{ mark }}</label>
                {%- if block.settings.long -%}
                  <textarea id="{{ qid }}" class="ha-reg-form__input ha-feedback__textarea ha-narrate" rows="4" maxlength="2000" data-klaviyo-prop="{{ key }}"></textarea>
                {%- else -%}
                  <input id="{{ qid }}" class="ha-reg-form__input ha-narrate" type="text" maxlength="400" data-klaviyo-prop="{{ key }}">
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.note_text != blank -%}
          <div class="ha-reg-form__note ha-record">{{ section.settings.note_text }}</div>
        {%- endif -%}

        <button type="submit" class="ha-reg-form__submit ha-record ha-grain-block">{{ section.settings.submit_text }}</button>
      {%- endform -%}
      <script src="{{ 'ha-klaviyo-form.js' | asset_url }}" defer></script>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HA — Feedback form",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Friends & Family" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank uses the page title." },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "header", "content": "Who is answering" },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Your email *", "info": "Required: it is how the answers find the right person in Klaviyo." },
    { "type": "header", "content": "Sending" },
    { "type": "richtext", "id": "note_text", "label": "Line above the button", "default": "<p>Your answers go to Angela. Answering does not subscribe you to anything.</p>" },
    { "type": "text", "id": "submit_text", "label": "Button", "default": "Send feedback" },
    { "type": "text", "id": "event_name", "label": "Klaviyo event", "default": "Friends & Family Feedback", "info": "The flow that emails Angela is triggered by this name. Change both together or the alert stops." },
    { "type": "text", "id": "register_source", "label": "Klaviyo source", "default": "friends_family_feedback" },
    { "type": "text", "id": "contact_tag", "label": "CRM tag (fallback only)", "default": "Friends & Family feedback", "info": "Used only if the page's script fails to load and Shopify takes the email instead." },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "msg_success", "label": "Success", "default": "Thank you. Your feedback has been sent to Angela." },
    { "type": "text", "id": "msg_invalid", "label": "Invalid email", "default": "Please enter your email address." },
    { "type": "text", "id": "msg_required", "label": "Question missed", "default": "Please answer the questions marked *." },
    { "type": "text", "id": "msg_submitting", "label": "While sending", "default": "One moment…" },
    { "type": "text", "id": "msg_error", "label": "Service error", "default": "That did not go through. Please try again, or write to contact@hartwickatelier.com." },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true },
    { "type": "text", "id": "placeholder_text", "label": "Notice text", "default": "Placeholder — questions to be replaced with Christina's." }
  ],
  "blocks": [
    {
      "type": "scale",
      "name": "Question: 1–5 scale",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "text", "id": "low_label", "label": "1 means", "default": "Not at all" },
        { "type": "text", "id": "high_label", "label": "5 means", "default": "Very much" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "text", "id": "key", "label": "Klaviyo key", "info": "Short name for this answer in Klaviyo, e.g. overall_rating. Blank makes one from the question; keep it fixed once the alert email uses it." }
      ]
    },
    {
      "type": "choice",
      "name": "Question: choice",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "options", "label": "Options", "info": "One per line." },
        { "type": "checkbox", "id": "multiple", "label": "Allow more than one", "default": false },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "text", "id": "key", "label": "Klaviyo key", "info": "Blank makes one from the question." }
      ]
    },
    {
      "type": "text",
      "name": "Question: written",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "checkbox", "id": "long", "label": "Long answer (several lines)", "default": true },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "text", "id": "key", "label": "Klaviyo key", "info": "Blank makes one from the question." }
      ]
    }
  ],
  "presets": [{ "name": "HA — Feedback form" }]
}
{% endschema %}
