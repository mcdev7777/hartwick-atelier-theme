{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — THE COLLECTION INDEX (the /collections page).
  Aloha's "Collection Index brief" and Hartwick_Collection_Index_Refined
  (artboard 1: the page; artboard 2: rest and hover states), 17 September 2026.

  A photographic header carrying the title, the introduction and the OPENING
  DIRECTORY — four columns, one per collection, whose links JUMP to places on
  this page (a section, or a card). Then four sections, each a rail (number,
  heading, count, Back to index, the numbered index, View all) beside its
  image group: Apparel's asymmetric five; Fine Silk's editorial photograph
  and seven format cards; Fine Jewellery's four; Yoga's one feature.

  ONE NAME. ONE IMAGE. ONE DESTINATION. Every entry is one `entry` block —
  stable key, display number, name, secondary descriptor, shopping
  destination, colour photograph, alt text — grouped under the `group` block
  before it in the block order. The same block feeds the directory, the rail
  index, the card and its caption, so they cannot disagree, and staff change
  an image or a destination in the theme editor without touching code
  (brief, "Maintain it from Shopify"). Page anchors (#idx-1-01) and store
  destinations (the block's URL) are kept apart on purpose.

  THE COLOUR REVEAL. Colour originals, grayscale at rest. Hovering or
  focusing an index name reveals ONLY its matching photograph and underlines
  the matching name and caption; hovering the card does the same in reverse.
  The two live in different containers, so assets/ha-index.js carries the
  key across (data-idx); with no script the card still colours on its own
  hover and every link still works. 220 ms, none under reduced motion; touch
  screens show colour and open on one tap. Hover never scrolls the page.

  One H1 (The Collection Index); an H2 per collection; every name and card a
  real link with the destination in its href.
{%- endcomment -%}

{%- liquid
  assign hero = section.settings.header_image
  assign hero_focus = '--ha-idx-focus: ' | append: section.settings.header_focus_x | append: '% ' | append: section.settings.header_focus_y | append: '%'
-%}
<script src="{{ 'ha-index.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ha-collection-categories.js' | asset_url }}" defer="defer"></script>

<div class="ha-idx">

  {%- comment -%} ---------- HEADER + OPENING DIRECTORY ---------- {%- endcomment -%}
  <header class="ha-idx__head{% if hero %} ha-idx__head--photo{% endif %}" id="index">
    {%- if hero -%}
      <div class="ha-idx__head-media" aria-hidden="true">
        {{ hero | image_url: width: 2800 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', alt: '', class: 'ha-idx__head-img', style: hero_focus }}
        <span class="ha-idx__scrim"></span>
      </div>
    {%- endif -%}
    <div class="ha-wrap ha-idx__head-inner">
      <nav class="ha-idx__crumbs ha-record" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ shop.name }}</a><span aria-hidden="true"> / </span><span>{{ section.settings.crumb }}</span></nav>
      <div class="ha-idx__title-row">
        <h1 class="ha-idx__title ha-narrate">{{ section.settings.heading }}</h1>
        {%- if section.settings.intro != blank -%}<p class="ha-idx__intro ha-narrate">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
      <hr class="ha-idx__rule">
      <div class="ha-idx__dir-labels ha-record"><span>{{ section.settings.dir_label }}</span>{% if section.settings.dir_count != blank %}<span>{{ section.settings.dir_count }}</span>{% endif %}</div>
      <nav class="ha-idx__dir" aria-label="{{ section.settings.dir_label }}">
        {%- assign gi = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'group' -%}
            {%- if gi > 0 -%}</ul></div>{%- endif -%}
            {%- assign gi = gi | plus: 1 -%}
            <div class="ha-idx__dir-col">
              <h2 class="ha-idx__dir-heading ha-narrate"><span class="ha-idx__dir-num ha-record">{{ block.settings.number }}</span><a href="#{{ block.settings.anchor }}">{{ block.settings.heading }}</a></h2>
              <ul class="ha-idx__dir-list" role="list">
              {%- if block.settings.dir_mode == 'summary' -%}
                <li><a class="ha-idx__dir-link ha-identify" href="#{{ block.settings.anchor }}">{{ block.settings.dir_summary }}</a></li>
                {%- if block.settings.dir_second != blank -%}<li><a class="ha-idx__dir-link ha-idx__dir-link--quiet ha-identify" href="#{{ block.settings.anchor }}-formats">{{ block.settings.dir_second }}</a></li>{%- endif -%}
              {%- endif -%}
          {%- elsif block.type == 'entry' -%}
            {%- assign g = nil -%}
            {%- for b2 in section.blocks -%}{%- if b2.type == 'group' -%}{%- assign g = b2 -%}{%- endif -%}{%- if b2.id == block.id -%}{%- break -%}{%- endif -%}{%- endfor -%}
            {%- if g.settings.dir_mode == 'entries' -%}
              {%- assign target = '#idx-' | append: block.settings.key -%}
              {%- if g.settings.dir_direct -%}{%- assign target = block.settings.url -%}{%- endif -%}
              <li><a class="ha-idx__dir-link ha-identify" href="{{ target }}">{{ block.settings.name }}{% if block.settings.secondary != blank and g.settings.dir_show_secondary %} / {{ block.settings.secondary }}{% endif %}</a></li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if gi > 0 -%}</ul></div>{%- endif -%}
      </nav>
    </div>
  </header>

  {%- comment -%} ---------- THE FOUR SECTIONS ---------- {%- endcomment -%}
  {%- assign open = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'group' -%}
      {%- if open -%}
            </ul>
          </div>
        </section>
      {%- endif -%}
      {%- assign open = true -%}
      {%- assign layout = block.settings.layout -%}
      <section class="ha-section ha-idx__group ha-idx__group--{{ layout }}" id="{{ block.settings.anchor }}" {{ block.shopify_attributes }}>
        <div class="ha-wrap ha-idx__group-grid">
          <div class="ha-idx__rail">
            <div class="ha-idx__rail-inner">
              <p class="ha-idx__num ha-record">{{ block.settings.number }}</p>
              <h2 class="ha-idx__heading ha-narrate">{{ block.settings.heading }}</h2>
              {%- if block.settings.count_label != blank -%}<p class="ha-idx__count ha-record">{{ block.settings.count_label }}</p>{%- endif -%}
              <a class="ha-idx__back ha-identify" href="#index">{{ section.settings.back_text }}<span class="ha-idx__chev" aria-hidden="true"></span></a>
              <ol class="ha-idx__index" role="list">
                {%- for e in section.blocks -%}
                  {%- assign owner = nil -%}
                  {%- for b2 in section.blocks -%}{%- if b2.type == 'group' -%}{%- assign owner = b2 -%}{%- endif -%}{%- if b2.id == e.id -%}{%- break -%}{%- endif -%}{%- endfor -%}
                  {%- if e.type == 'entry' and owner.id == block.id -%}
                    <li class="ha-idx__index-item">
                      <a class="ha-idx__index-link" href="{{ e.settings.url | default: '#' }}" data-idx="{{ e.settings.key }}">
                        <span class="ha-idx__index-num ha-record">({{ e.settings.number }})</span>
                        <span class="ha-idx__index-name ha-identify">{{ e.settings.name }}</span>
                        {%- if e.settings.secondary != blank -%}<span class="ha-idx__index-sec ha-record">{{ e.settings.secondary }}</span>{%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
              {%- if block.settings.view_all_text != blank -%}
                <a class="ha-idx__viewall ha-identify" href="{{ block.settings.view_all_url | default: '#' }}">{{ block.settings.view_all_text }}</a>
              {%- endif -%}
            </div>
          </div>

          <div class="ha-idx__cards-wrap">
            {%- if block.settings.editorial_image -%}
              <figure class="ha-idx__editorial">
                {{ block.settings.editorial_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 70vw, 100vw', widths: '600, 900, 1200, 1600, 2000', alt: block.settings.editorial_alt, class: 'ha-idx__editorial-img' }}
              </figure>
            {%- endif -%}
            <ul class="ha-idx__cards" role="list" id="{{ block.settings.anchor }}-formats">
    {%- elsif block.type == 'entry' and open -%}
      {%- assign img = block.settings.image -%}
      {%- assign alt = block.settings.alt | default: block.settings.name -%}
      {%- assign card_focus = '--ha-idx-focus: ' | append: block.settings.focus_x | append: '% ' | append: block.settings.focus_y | append: '%' -%}
              <li class="ha-idx__card ha-idx__card--{{ block.settings.shape }}" id="idx-{{ block.settings.key }}" {{ block.shopify_attributes }}>
                <a class="ha-idx__card-link" href="{{ block.settings.url | default: '#' }}" data-idx="{{ block.settings.key }}" aria-label="{{ block.settings.name | escape }}{% if block.settings.secondary != blank %}, {{ block.settings.secondary | escape }}{% endif %}">
                  <figure class="ha-idx__figure{% unless img %} ha-figure--empty{% endunless %}">
                    {%- if img -%}
                      {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 34vw, (min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1400', alt: alt, class: 'ha-idx__img', style: card_focus }}
                    {%- else -%}
                      <span class="ha-idx__empty ha-record">{{ section.settings.empty_text }}</span>
                    {%- endif -%}
                  </figure>
                  <span class="ha-idx__caption">
                    <span class="ha-idx__caption-num ha-record">({{ block.settings.number }})</span>
                    <span class="ha-idx__caption-name ha-narrate">{{ block.settings.name }}</span>
                    {%- if block.settings.secondary != blank -%}<span class="ha-idx__caption-sec ha-record">{{ block.settings.secondary }}</span>{%- endif -%}
                    {%- if block.settings.note != blank -%}<span class="ha-idx__caption-note ha-narrate">{{ block.settings.note }}</span>{%- endif -%}
                  </span>
                </a>
              </li>
    {%- endif -%}
  {%- endfor -%}
  {%- if open -%}
            </ul>
          </div>
        </section>
  {%- endif -%}

  {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: section.settings.placeholder_text -%}
</div>

{% schema %}
{
  "name": "HA — Index page",
  "tag": "section",
  "class": "ha-section-wrapper",
  "max_blocks": 50,
  "settings": [
    { "type": "paragraph", "content": "The Collection Index (refined, 17 Sept 2026). Add a Group block per collection, then its Entry blocks beneath it. Each Entry is one name, one image, one destination." },
    { "type": "header", "content": "Header" },
    { "type": "image_picker", "id": "header_image", "label": "Photograph" },
    { "type": "range", "id": "header_focus_x", "label": "Focus, horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "header_focus_y", "label": "Focus, vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "crumb", "label": "Breadcrumb leaf", "default": "Collection" },
    { "type": "text", "id": "heading", "label": "Title", "default": "The Collection Index" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Apparel, silk scarves, fine jewellery and yoga mats. Find your way by category." },
    { "type": "text", "id": "dir_label", "label": "Directory label", "default": "Explore the index" },
    { "type": "text", "id": "dir_count", "label": "Directory right label", "info": "Empty by default — Aloha removed \"Four collections\" on 18 September 2026." },
    { "type": "header", "content": "Sections" },
    { "type": "text", "id": "back_text", "label": "Back to index", "default": "Back to index" },
    { "type": "text", "id": "empty_text", "label": "Empty image reads", "default": "Photograph to supply" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true },
    { "type": "text", "id": "placeholder_text", "label": "Notice", "default": "Provisional photographs from the store's own files until approved, correctly matched images are supplied." }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group (a collection)",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Apparel" },
        { "type": "text", "id": "count_label", "label": "Count label", "default": "Five categories" },
        { "type": "text", "id": "anchor", "label": "Anchor (URL #id)", "default": "idx-clothing" },
        { "type": "select", "id": "layout", "label": "Image group", "default": "clothing", "options": [
          { "value": "clothing", "label": "Asymmetric five" }, { "value": "silk", "label": "Editorial + format cards" },
          { "value": "jewellery", "label": "Four cards" }, { "value": "yoga", "label": "One feature" }
        ] },
        { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View all apparel" },
        { "type": "url", "id": "view_all_url", "label": "View all URL" },
        { "type": "header", "content": "Opening directory" },
        { "type": "select", "id": "dir_mode", "label": "Directory lists", "default": "entries", "options": [
          { "value": "entries", "label": "Each entry (jump to its card)" }, { "value": "summary", "label": "A summary line (jump to the section)" }
        ] },
        { "type": "checkbox", "id": "dir_show_secondary", "label": "Show the secondary descriptor in the directory", "default": false },
        { "type": "checkbox", "id": "dir_direct", "label": "Directory links go straight to the destination", "default": false, "info": "Yoga: the shopping link goes to the product page, not a card." },
        { "type": "text", "id": "dir_summary", "label": "Summary line", "default": "Silk scarves — seven formats" },
        { "type": "text", "id": "dir_second", "label": "Second line (jumps to the cards)", "default": "Explore silk formats" },
        { "type": "header", "content": "Editorial photograph (Fine Silk)" },
        { "type": "image_picker", "id": "editorial_image", "label": "Photograph" },
        { "type": "text", "id": "editorial_alt", "label": "Alt text" }
      ]
    },
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "key", "label": "Stable key", "default": "1-01", "info": "Never shown; ties the index name, card and caption together. Keep it once set." },
        { "type": "text", "id": "number", "label": "Display number", "default": "1/01" },
        { "type": "text", "id": "name", "label": "Name", "default": "Skirts" },
        { "type": "text", "id": "secondary", "label": "Secondary descriptor", "info": "Fingers · 33 × 33 cm" },
        { "type": "text", "id": "note", "label": "Caption note", "info": "Yoga: For your practice." },
        { "type": "url", "id": "url", "label": "Shopping destination" },
        { "type": "image_picker", "id": "image", "label": "Photograph (colour original)" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "range", "id": "focus_x", "label": "Focus, horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "range", "id": "focus_y", "label": "Focus, vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
        { "type": "select", "id": "shape", "label": "Card shape", "default": "wide", "options": [
          { "value": "tall", "label": "Tall" }, { "value": "wide", "label": "Wide" }, { "value": "square", "label": "Square" }, { "value": "feature", "label": "Feature (full width)" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "HA — Index page" }]
}
{% endschema %}
