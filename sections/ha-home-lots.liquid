{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — HOMEPAGE 05 / MADE IN LOTS.
  Aloha's Hartwick_Homepage_Editorial artboard, 19 September 2026, §09:

      "The Lots block explains the concept without inventing allocations or
       quantities."

  Text left — eyebrow, heading, one paragraph, a ruled link — and a print on
  the right. The artboard sets the print as two folded sheets of the same
  photograph. Aloha supplied that collage as a cut-out with a transparent
  surround on 21 September 2026, so with "carries its own paper mat" on the
  theme draws no mat and the folded sheets sit straight on the ground; off,
  a plain photograph gets the theme's mat. No Lot number, count or
  allocation appears here:
  Lots are explained, not enumerated (Framework v3: Lot I, Lot II are the
  customer-facing forms, and none is confirmed).
{%- endcomment -%}

<section class="ha-home ha-home-lots" aria-labelledby="ha-home-lots-title">
  <div class="ha-wrap">
    {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: 'Placeholder — proposed copy for Aloha to confirm before launch.' -%}

    <div class="ha-home-lots__grid">
      <div class="ha-home-lots__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ha-home__eyebrow ha-identify">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="ha-home-lots-title" class="ha-home__heading ha-narrate">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="ha-home-lots__body ha-home__lead ha-narrate">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.link_text != blank -%}
          <a class="ha-home__ruled ha-record" href="{{ section.settings.link_url | default: '/collections/apparel' }}">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>

      <div class="ha-home-lots__media">
        <div class="ha-home__print ha-home-lots__print{% if section.settings.own_mat %} ha-home__print--own-mat{% endif %}">
          {%- if section.settings.image -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 36vw, 100vw', widths: '400, 600, 800, 1000, 1200, 1600', alt: section.settings.image_alt, class: 'ha-home-lots__img'
            }}
          {%- else -%}
            <span class="ha-figure ha-figure--empty ha-home-lots__empty"><span class="ha-figure__label ha-record">Print / To supply</span></span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HA — Home: Made in Lots",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made in Lots" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A record of the making." },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>A Lot is a numbered series of clothing. It brings together pieces that share a period of making and gives us a way to keep that work visible.</p>" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Explore all Apparel" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Print" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "The pink façade of the Hawa Mahal in Jaipur, rows of carved windows" },
    { "type": "checkbox", "id": "own_mat", "label": "Print carries its own paper mat", "info": "For a cut-out supplied on its mat with a transparent surround. The theme then draws no mat of its own.", "default": false },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "presets": [{ "name": "HA — Home: Made in Lots" }]
}
{% endschema %}
