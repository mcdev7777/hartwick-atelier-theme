{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{% style %}
  .article-template {
    padding-top: {{ section.settings.top_padding }}px;
    padding-bottom: {{ section.settings.bottom_padding }}px;
  }
{% endstyle %}

{% assign date_format = settings.date_format %}

<article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="page-width-narrow">
          {% render block %}
        </div>
      
      {%- when 'header' -%}
      <style>
        .article-template--hero-image {
          padding-top: {{ block.settings.image_top_padding | times: 0.5 }}px;
          padding-bottom: {{ block.settings.image_bottom_padding | times: 0.5 }}px;
        }
          @media only screen and (min-width: 750px) {
          .article-template--hero-image {
            padding-top: {{ block.settings.image_top_padding }}px;
            padding-bottom: {{ block.settings.image_bottom_padding }}px;
          }
        }
      </style>      
      {% if block.settings.header_style == 'banner' or block.settings.header_style == 'banner_fullscreen' and article.image %}
        <div class="article-header-banner {% if block.settings.header_style == 'banner_fullscreen' %}article-header-banner-fullscreen{% endif %}" {{ block.shopify_attributes }}>
        <div class="article-header-banner--text align-{{ block.settings.txt_alignment }}">
        <h1 class="article-header--title {{ block.settings.heading_size }}" itemprop="headline">{{ article.title | escape }}</h1>
        <div class="article-header--blog-title">
        {%- if block.settings.blog_show_title -%}<span>{{ blog.title }}</span>{%- endif -%}
        {%- if block.settings.blog_show_title and block.settings.blog_show_date -%}<span class="divider-bullet">&bull;</span>{%- endif -%}
        {%- if block.settings.blog_show_date -%}
          <span class="article-header--data-date" itemprop="dateCreated pubdate datePublished">
            {{- article.published_at | time_tag: date_format -}}
          </span>
        {%- endif -%}
        </div> 
        {%- if block.settings.blog_show_author -%}
          <span class="article-header--data-author" itemprop="author" itemscope itemtype="http://schema.org/Person">
            <span itemprop="name">{{ article.author }}</span>
          </span>
        {%- endif -%}
        </div>
        {%- if article.image -%}
        <div class="article-header-banner--bg-img">
        {{ article.image | image_url: width: 2800 | image_tag }}
        </div>
        {%- endif -%}
        </div>

          {% if block.settings.blog_show_excerpt and article.excerpt.size > 0 %}
          <div class="page-width-narrow align-{{ block.settings.txt_alignment }}">
          <div class="article-header--excerpt article-header--excerpt-below-banner text-large">
            <p>{{ article.excerpt }}</p> 
          </div>
          </div>
          {% endif %}
        
        {% else %}
        <div class="article-header page-width {{ block.settings.txt_alignment }}" {{ block.shopify_attributes }}>
        {%- if block.settings.blog_show_title -%}<div class="article-header--blog-title">{{ blog.title }}</div>{%- endif -%}
          <div class="article-header--blog-meta-data">
          {%- if block.settings.blog_show_date -%}
            <span class="article-header--data-date" itemprop="dateCreated pubdate datePublished">
              {{ article.published_at | time_tag: date_format }}
            </span>
          {%- endif -%}
        {%- if block.settings.blog_show_author and block.settings.blog_show_date -%}<span class="divider-bullet">&bull;</span>{%- endif -%}
          {%- if block.settings.blog_show_author -%}
            <span class="article-header--data-author" itemprop="author" itemscope itemtype="http://schema.org/Person">
              <span itemprop="name">{{ article.author }}</span>
            </span>
          {%- endif -%}
          </div>
          <h1 class="article-header--title {{ block.settings.heading_size }}" itemprop="headline">{{ article.title | escape }}</h1>

          {% if block.settings.blog_show_excerpt and article.excerpt.size > 0 %}
          <div class="article-header--excerpt text-large">
            <p>{{ article.excerpt }}</p> 
          </div>
          {% endif %}

          {%- if article.image -%}
          <div class="article-template--hero-image article-hero-image-stacked article-hero-image-{{ block.settings.header_img_ratio }}">
            <div class="image-wrapper">
            {{ article.image | image_url: width: 2400 | image_tag }}
            </div>
          </div>
        {%- endif -%}
        </div>

        {% endif %}
      
      {%- when 'content' -%}
          {% style %}
            .article-template__content {
              padding-top: {{ block.settings.top_padding }}px;
              padding-bottom: {{ block.settings.bottom_padding }}px;
            }
          {% endstyle %}
        <div
          class="article-template__content page-width-narrow rte"
          itemprop="articleBody"
          {{ block.shopify_attributes }}
        >
          {{ article.content }}
        </div>

      {%- when 'footer' -%}
      <style>
        .article-footer {
          padding-top: {{ block.settings.top_padding | times: 0.5 }}px;
          padding-bottom: {{ block.settings.bottom_padding | times: 0.5 }}px;
        }
        @media {
          .article-footer {
            padding-top: {{ block.settings.top_padding }}px;
            padding-bottom: {{ block.settings.bottom_padding }}px;
          }
        }
      </style>
      <div class="article-footer page-width-narrow align-{{ block.settings.txt_alignment }}" {{ block.shopify_attributes }}>
        <hr>
        {% if block.settings.show_tags %}
        <div class="article-footer-tags">
        {% for tag in article.tags %}
        <a class="article-footer-tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
        {% endfor %}
        </div>
        {% endif %}
        
        {% if block.settings.show_author or block.settings.show_date %}
        <div class="article-footer-author-date">
          {% if block.settings.show_author %}
        <span class="article-footer--data-author" itemprop="author" itemscope itemtype="http://schema.org/Person">
          <span itemprop="name">{{ article.author }}</span>
        </span>
        {% endif %}
        {% if block.settings.show_date %}
        <span class="article-footer--data-date" itemprop="dateCreated pubdate datePublished">
          {{- article.published_at | time_tag: date_format -}}
        </span>
        {% endif %}
        </div>
        {% endif %}
  
        {% if block.settings.enable_sharing %}
          <div class="article-footer-share">
          {% capture permalinkURL %}{{ shop.url }}{{ article.url }}{% endcapture %}
          {% if block.settings.share_label != blank %}
            <span class="article-footer-share-title">{{ block.settings.share_label }}</span>
          {% endif %}
          <div class="social-sharing-component" {{ block.shopify_attributes }}>
            {% if block.settings.share_enable_facebook %}<a href="https://facebook.com/sharer.php?u={{ permalinkURL }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}">{% render 'icon-facebook' %}</a>{% endif %}
            {% if block.settings.share_enable_x %}<a href="https://twitter.com/home?status={{ permalinkURL }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_twitter' | t }}">{% render 'icon-twitter-x' %}</a>{% endif %}
            {% if block.settings.share_enable_pinterest %}<a href="https://pinterest.com/pin/create/button/?url={{ permalinkURL }}&description={{ article.title }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_pinterest' | t }}">{% render 'icon-pinterest' %}</a>{% endif %}
            {% if block.settings.share_enable_linkedin %}<a href="https://www.linkedin.com/shareArticle?url={{ permalinkURL }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_linkedin' | t }}">{% render 'icon-linkedin' %}</a>{% endif %}
          </div>
          </div>
          {% endif %}
      </div>
    {%- endcase -%}
  {%- endfor -%}


  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper">
      <div id="comments" class="page-width page-width-narrow">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 class="h3" id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if article.comment.status == 'pending' and article.comment.content -%}
                <article id="{{ article.comment.id }}" class="article-template__comments-comment">
                  <div class="article-template__comment-header">
                  <div class="article-template__comment-avatar">
                  {{ article.comment.author | split: " " | first | slice: 0 }}{{ article.comment.author | split: " " | last | slice: 0 }}
                  </div>
                  <div class="article-template__comment-author-data">
                  <span>{{ article.comment.author }}</span>
                  <span class="article-comment-date">{{- article.comment.created_at | time_tag: date_format -}}</span>
                  </div>
                  </div>

                  <div class="article-template__comment-text">
                  {{ article.comment.content }}
                  </div>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  <div class="article-template__comment-header">
                  <div class="article-template__comment-avatar">
                  {{ comment.author | split: " " | first | slice: 0 }}{{ comment.author | split: " " | last | slice: 0 }}
                  </div>
                  <div class="article-template__comment-author-data">
                  <span>{{ comment.author }}</span>
                  <span class="article-comment-date">{{- comment.created_at | time_tag: date_format -}}</span>
                  </div>
                  </div>
                
                  <div class="article-template__comment-text">
                  {{ comment.content }}
                  </div> 
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and article.comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2 class="h3">{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                {% render 'icon-error' %}
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >

                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>

            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  {%- render 'icon-error' -%}
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      "image": [
        {{ article | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "settings": [
  {
  "type": "range",
  "id": "top_padding",
  "min": 0,
  "max": 180,
  "step": 10,
  "unit": "px",
  "default": 0,
  "label": "t:sections.all.padding.padding_top"
  },
  {
  "type": "range",
  "id": "bottom_padding",
  "min": 0,
  "max": 180,
  "step": 10,
  "unit": "px",
  "default": 60,
  "label": "t:sections.all.padding.padding_bottom"
  }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "header",
      "name": "t:sections.main-article.blocks.header.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "header_style",
          "options": [
            {
              "value": "banner",
              "label": "t:sections.main-article.blocks.header.settings.header_style.options__1.label"
            },
            {
              "value": "banner_fullscreen",
              "label": "t:sections.main-article.blocks.header.settings.header_style.options__2.label"
            },
            {
              "value": "default",
              "label": "t:sections.main-article.blocks.header.settings.header_style.options__3.label"
            }            
          ],
          "default": "banner",
          "label": "t:sections.main-article.blocks.header.settings.header_style.label"
        },
        {
          "type": "select",
          "id": "txt_alignment",
          "label": "t:sections.all.alignment.alignment_header",
          "options": [
            {
              "value": "left",
              "label": "t:sections.all.alignment.left"
            },
            {
              "value": "center",
              "label": "t:sections.all.alignment.center"
            }
    		],
          "default": "center"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.all.size.text_size",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.all.size.medium"
            },
            {
              "value": "h0",
              "label": "t:sections.all.size.large"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.size.xl"
            }
          ],
          "default": "h1"
        },        
        {
          "type": "checkbox",
          "id": "blog_show_title",
          "default": true,
          "label": "t:sections.main-article.blocks.header.settings.show_title.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.header.settings.show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "t:sections.main-article.blocks.header.settings.show_author.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_excerpt",
          "default": true,
          "label": "t:sections.main-article.blocks.header.settings.show_excerpt.label"
        },        
        {
          "type": "header",
          "content": "t:sections.all.image",
          "info": "t:sections.main-article.blocks.header.settings.header__image.info"
        },
        {
          "type": "select",
          "id": "header_img_ratio",
          "options": [
            {
              "value": "landscape-6x4",
              "label": "t:sections.all.ratio.landscape_6_4"
            },
            {
              "value": "landscape-16x9",
              "label": "t:sections.all.ratio.landscape_16_9"
            },
            {
              "value": "adapt",
              "label": "t:sections.all.ratio.adapt_to_image"
            }          
          ],
          "default": "landscape-6x4",
          "label": "t:sections.all.ratio.ratio_heading"
        },
        {
        "type": "range",
        "id": "image_top_padding",
        "min": 0,
        "max": 180,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_top"
        },
        {
        "type": "range",
        "id": "image_bottom_padding",
        "min": 0,
        "max": 180,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_bottom"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1,
      "settings": [
        {
        "type": "range",
        "id": "top_padding",
        "min": 0,
        "max": 180,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_top"
        },
        {
        "type": "range",
        "id": "bottom_padding",
        "min": 0,
        "max": 180,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_bottom"
        }        
      ]
    },
    {
      "type": "footer",
      "name": "t:sections.main-article.blocks.footer.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "txt_alignment",
          "label": "t:sections.all.alignment.alignment_header",
          "options": [
            {
              "value": "left",
              "label": "t:sections.all.alignment.left"
            },
            {
              "value": "center",
              "label": "t:sections.all.alignment.center"
            }
    		],
          "default": "left"
        },
        {
        "type": "range",
        "id": "top_padding",
        "min": 0,
        "max": 120,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_top"
        },
        {
        "type": "range",
        "id": "bottom_padding",
        "min": 0,
        "max": 120,
        "step": 10,
        "unit": "px",
        "default": 40,
        "label": "t:sections.all.padding.padding_bottom"
        },
        {
          "type": "header",
          "content": "t:sections.main-article.blocks.footer.settings.header__1.label"
        },
        {
    	"type": "checkbox",
    	"id": "show_tags",
    	"default": true,
        "label": "t:sections.main-article.blocks.footer.settings.show_tags.label"
    	},
        {
    	"type": "checkbox",
    	"id": "show_author",
    	"default": true,
        "label": "t:sections.main-article.blocks.footer.settings.show_author.label"
    	},
        {
    	"type": "checkbox",
    	"id": "show_date",
    	"default": true,
        "label": "t:sections.main-article.blocks.footer.settings.show_date.label"
    	},
        {
          "type": "header",
          "content": "t:sections.main-article.blocks.footer.settings.header__2.label"
        },
        {
    	"type": "checkbox",
    	"id": "enable_sharing",
    	"default": true,
        "label": "t:sections.main-article.blocks.footer.settings.enable_sharing.label"
    	},
        {
          "type": "text",
          "id": "share_label",
          "label": "t:sections.main-article.blocks.footer.settings.sharing_header.label",
          "default": "Share"
        },
        {
          "type": "paragraph",
          "content": "t:sections.main-article.blocks.footer.settings.featured_image_info.content"
        },
        {
          "type": "paragraph",
          "content": "t:sections.main-article.blocks.footer.settings.title_info.content"
        },
        {
    	"type": "checkbox",
    	"id": "share_enable_facebook",
    	"default": true,
        "label": "Facebook"
    	},
        {
    	"type": "checkbox",
    	"id": "share_enable_x",
    	"default": true,
        "label": "X (Twitter)"
    	},
        {
    	"type": "checkbox",
    	"id": "share_enable_pinterest",
    	"default": true,
        "label": "Pinterest"
    	},
        {
    	"type": "checkbox",
    	"id": "share_enable_linkedin",
    	"default": true,
