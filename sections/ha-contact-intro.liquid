{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — CONTACT PAGE 01 / GET IN TOUCH.
  Aloha's contact artboard, 24 September 2026 (Temp Files zip, the 16.01.08
  screenshot).

  Two record-voice lines across the top ("Hartwick Atelier / Correspondence",
  "01 / Get in touch"); CONTACT in capitals across the page in the band colour
  (#502F37), its O a spot of the Atelier's dye (her SH_CIRCLES_02 picture);
  three short lines at the left ("A question about a piece. / A visit to the
  Atelier. / Write to us."); at the right the ways to write, each a block —
  a record-voice label, an optional line, the address or handle, ruled
  between; and two record-voice lines along the foot.

  The page title is the h1, read as the word; the drawn word with the spot
  is hidden from assistive technology so it is not read as "C NTACT".
  `spot_letter` says which letter the spot replaces (2 = the O).

  Grain: `.ha-page-grain` — the page ground carries Aloha's grain at the
  Page grain strength (Theme settings, 30%); her dye spot and every picture
  sit above it.

  24 September, her second version (Hartwick_Contact_Editable.pdf): the band
  lies on her grey paper photograph (`paper`), under a transparent menu
  (header setting "Transparent on the contact page"); CONTACT is Junicode
  SemiCond SemiBold in Chalk Blue, the addresses Chalk Blue, the rules peat,
  the labels in the identify voice (Porter) instead of the record voice.
{%- endcomment -%}

{%- liquid
  assign word = section.settings.heading | default: page.title | upcase
  assign n = section.settings.spot_letter | default: 2
  assign before_len = n | minus: 1
  assign word_size = word | size
  assign after_len = word_size | minus: n
  assign word_before = word | slice: 0, before_len
  assign word_after = word | slice: n, after_len
-%}

<section class="ha-contact ha-contact-intro{% if section.settings.grain %} ha-page-grain ha-grain-block{% endif %}{% if section.settings.paper %} ha-contact--paper{% endif %}"{% if section.settings.paper %} style="--ha-contact-paper: url({{ section.settings.paper | image_url: width: 2400 }});"{% endif %} aria-labelledby="ha-contact-title">
  <div class="ha-contact__wrap">
    {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note, text: "Placeholder — copy transcribed from Aloha's contact artboard, for her to confirm." -%}

    {%- if section.settings.eyebrow_left != blank or section.settings.eyebrow_right != blank -%}
      <div class="ha-contact__row ha-identify">
        <p>{{ section.settings.eyebrow_left }}</p>
        <p>{{ section.settings.eyebrow_right }}</p>
      </div>
    {%- endif -%}

    <h1 id="ha-contact-title" class="ha-contact__word ha-narrate">
      <span class="visually-hidden">{{ section.settings.heading | default: page.title }}</span>
      <span class="ha-contact__word-drawn" aria-hidden="true">
        {{- word_before -}}
        {%- if section.settings.spot_image -%}
          {{- section.settings.spot_image | image_url: width: 600 | image_tag: class: 'ha-contact__spot', loading: 'eager', sizes: '14vw', widths: '200, 300, 450, 600', alt: '' -}}
        {%- else -%}
          {{- word | slice: before_len, 1 -}}
        {%- endif -%}
        {{- word_after -}}
      </span>
    </h1>

    <div class="ha-contact-intro__grid">
      {%- if section.settings.intro != blank -%}
        <p class="ha-contact-intro__lines ha-narrate">{{ section.settings.intro | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ha-contact-intro__list" role="list">
          {%- for block in section.blocks -%}
            <li class="ha-contact-intro__item" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="ha-contact-intro__label ha-identify">{{ block.settings.label }}</p>
              {%- endif -%}
              {%- if block.settings.line != blank -%}
                <p class="ha-contact-intro__line ha-narrate">{{ block.settings.line }}</p>
              {%- endif -%}
              {%- if block.settings.value != blank -%}
                {%- if block.settings.link != blank -%}
                  <a class="ha-contact-intro__value ha-narrate" href="{{ block.settings.link }}"{% if block.settings.link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.value }}</a>
                {%- else -%}
                  <p class="ha-contact-intro__value ha-narrate">{{ block.settings.value }}</p>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.foot_left != blank or section.settings.foot_right != blank -%}
      <div class="ha-contact__row ha-contact__row--foot ha-identify">
        <p>{{ section.settings.foot_left }}</p>
        <p>{{ section.settings.foot_right }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "HA — Contact: Intro",
  "tag": "section",
  "class": "ha-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow_left", "label": "Top line, left", "default": "Hartwick Atelier / Correspondence" },
    { "type": "text", "id": "eyebrow_right", "label": "Top line, right", "default": "01 / Get in touch" },
    { "type": "text", "id": "heading", "label": "Word", "default": "Contact", "info": "The page title, drawn across the page in capitals. Colour: Theme settings > Correspondence band." },
    { "type": "image_picker", "id": "spot_image", "label": "Dye spot", "info": "Aloha's spot of dye, cut out on a transparent ground; it takes the place of one letter." },
    { "type": "range", "id": "spot_letter", "label": "Letter the spot replaces", "min": 1, "max": 7, "step": 1, "default": 2, "info": "2 = the O of CONTACT." },
    { "type": "textarea", "id": "intro", "label": "Lines at the left", "default": "A question about a piece.\nA visit to the Atelier.\nWrite to us.", "info": "A new line breaks the text there." },
    { "type": "text", "id": "foot_left", "label": "Foot line, left", "default": "Cloth. People. Correspondence." },
    { "type": "text", "id": "foot_right", "label": "Foot line, right", "default": "Mallorca / and elsewhere" },
    { "type": "header", "content": "Ground" },
    { "type": "image_picker", "id": "paper", "label": "Paper photograph", "info": "Aloha's grey paper (24 September), laid under the whole band. Empty = the page ground." },
    { "type": "checkbox", "id": "grain", "label": "Grain", "default": true, "info": "Page grain strength (Theme settings). The photographs stay above it." },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Way to write",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Appointments / Wholesale / Press" },
        { "type": "text", "id": "line", "label": "Line (optional)", "info": "E.g. a role, set above the address." },
        { "type": "text", "id": "value", "label": "Address or handle", "default": "contact@hartwickatelier.com" },
        { "type": "text", "id": "link", "label": "Links to", "info": "mailto:name@hartwickatelier.com for an address, or the profile's web address (https://…). Empty = plain text." }
      ]
    }
  ],
  "presets": [{ "name": "HA — Contact: Intro" }]
}
{% endschema %}
