{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — HOMEPAGE BINDING: the dark bar between two sections,
  with or without binder rings.
  Aloha's remade homepage, 23 September 2026 (Downloads/Asset 1.pdf): the
  sections are bound like the pages of a folder. A 16px bar of the binding
  colour runs the full width; where drawn, three rings pass through it at
  the artboard's 118 / 722 / 1326 on 1440, each from a punched hole 44px
  above the bar to a second hole on the page below. The Masters band (a
  photograph) was first drawn without the lower hole; Aloha, 23 September,
  asked for the holes there too, so "Above only" is now just an option.

  A section of its own so it can sit between any two sections and be moved
  or removed in the theme editor. Decorative only: aria-hidden throughout.
  The ring's colours are the artwork's own metal and paper, not tokens, in
  the same way the hero rings and the wordmark are.
{%- endcomment -%}

<div class="ha-home-binding{% if section.settings.rings %} ha-home-binding--rings{% endif %}" aria-hidden="true">
  {%- if section.settings.rings -%}
    {%- for i in (1..3) -%}
      <svg class="ha-home-binding__ring ha-home-binding__ring--{{ i }}" viewBox="0 0 40 220" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <circle cx="20" cy="18" r="16" fill="#26241f"/>
        {%- if section.settings.holes == 'both' -%}
          <circle cx="20" cy="202" r="16" fill="#26241f"/>
        {%- endif -%}
        <ellipse cx="20" cy="110" rx="10.5" ry="104" fill="#9a9589"/>
        <ellipse cx="20" cy="110" rx="9" ry="102" fill="#eeebe1"/>
        <ellipse cx="20.4" cy="110" rx="6.2" ry="96" fill="#bdb9ae"/>
        <ellipse cx="21.6" cy="110" rx="3.3" ry="88" fill="#1f1d18"/>
        <path d="M13.2 60 Q12.4 110 13.2 160" fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1" stroke-linecap="round"/>
      </svg>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HA — Home: Binding bar",
  "tag": "div",
  "class": "ha-home-binding-section",
  "settings": [
    { "type": "paragraph", "content": "The dark bar Aloha draws between homepage sections (23 September 2026). Colour: Theme settings > Hartwick — Material Archive > Binding bar." },
    { "type": "checkbox", "id": "rings", "label": "Binder rings", "default": true },
    {
      "type": "select", "id": "holes", "label": "Punched holes", "default": "both",
      "options": [
        { "value": "both", "label": "Above and below the bar (paper below)" },
        { "value": "top", "label": "Above only (a photograph below)" }
      ]
    }
  ],
  "presets": [{ "name": "HA — Home: Binding bar" }]
}
{% endschema %}
