{%- comment -%}
  Hartwick Atelier — PROCESS (Wireframe 04, revised).

  A row of circled process marks with a label beneath each, and the section
  heading set BELOW the row: "Only the processes that genuinely apply to this
  piece." The revised wireframe uses four marks — handspun, handwoven, natural
  dye, hand finished — which are the techniques actually used, not a fixed
  sequence. Add or remove a block to match the garment; nothing is invented.

  Product page only. Data may come from hartwick.process_steps; until then the
  blocks render.
{%- endcomment -%}

{%- liquid
  assign steps = product.metafields.hartwick.process_steps.value
  assign use_placeholders = true
  if steps != blank and steps.size > 0
    assign use_placeholders = false
  endif
-%}

<section class="ha-section ha-process{% unless section.settings.field == 'page' or section.settings.field == blank %} ha-section--field-{{ section.settings.field }}{% endunless %}">
  <div class="ha-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ha-eyebrow ha-record ha-process__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <ol class="ha-process__marks" role="list">
      {%- if use_placeholders -%}
        {%- for block in section.blocks -%}
          <li class="ha-process__mark" {{ block.shopify_attributes }}>
            <span class="ha-process__disc" aria-hidden="true">
              <span class="ha-process__num ha-record">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </span>
            <span class="ha-process__label ha-record">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for step in steps -%}
          <li class="ha-process__mark">
            <span class="ha-process__disc" aria-hidden="true">
              <span class="ha-process__num ha-record">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </span>
            <span class="ha-process__label ha-record">{{ step.label }}</span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>

    {%- if section.settings.heading != blank -%}
      <h2 class="ha-display ha-narrate ha-process__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if use_placeholders -%}
      {%- render 'ha-placeholder-note', show: section.settings.show_placeholder_note -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "HA — Process",
  "tag": "section",
  "class": "ha-section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "field", "label": "Field colour", "default": "page", "options": [
      { "value": "page", "label": "Page ground" }, { "value": "white", "label": "White" },
      { "value": "peat", "label": "Peat (dark)" }, { "value": "clay", "label": "Clay" },
      { "value": "botanical", "label": "Botanical" }, { "value": "slate", "label": "Slate (dark)" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Only the processes that genuinely apply to this piece." },
    { "type": "header", "content": "Provisional content" },
    { "type": "checkbox", "id": "show_placeholder_note", "label": "Show placeholder notice", "default": true }
  ],
  "blocks": [
    { "type": "step", "name": "Process", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Handspun" }
    ] }
  ],
  "presets": [{
    "name": "Hartwick — Process",
    "blocks": [
      { "type": "step", "settings": { "label": "Handspun" } },
      { "type": "step", "settings": { "label": "Handwoven" } },
      { "type": "step", "settings": { "label": "Natural dye" } },
      { "type": "step", "settings": { "label": "Hand finished" } }
    ]
  }]
}
{% endschema %}
