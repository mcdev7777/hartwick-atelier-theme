    { "type": "image_picker", "id": "glossary_symbol", "label": "Symbol (optional)" },
    { "type": "textarea", "id": "glossary_intro", "label": "Introduction", "default": "Explore the knowledge behind the work. Open a technique to read its story and watch the process." },
    { "type": "text", "id": "handwork_label", "label": "Handwork note label", "default": "Handwork naturally results in variations" },
    { "type": "text", "id": "handwork_line", "label": "Handwork note", "default": "We cherish these nuances for their human touch" },

    { "type": "header", "content": "From the archive — the wide film" },
    { "type": "video", "id": "feature_video", "label": "Film" },
    { "type": "image_picker", "id": "feature_poster", "label": "Poster (the opening image)" },
    { "type": "text", "id": "feature_poster_alt", "label": "Poster alt text", "default": "Black-and-white photographs from the Hartwick archive laid out on a table" },
    { "type": "range", "id": "feature_focus_x", "label": "Focus, horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "feature_focus_y", "label": "Focus, vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "checkbox", "id": "feature_mono", "label": "Show the poster in black and white", "default": true },
    { "type": "text", "id": "feature_eyebrow", "label": "Eyebrow", "default": "From the Hartwick archive" },
    { "type": "text", "id": "feature_title", "label": "Title", "default": "At the printing table." },
    { "type": "text", "id": "feature_sublabel", "label": "Line beneath the title (film only)", "default": "Watch the Master at work" },
    { "type": "richtext", "id": "feature_transcript", "label": "Transcript, or a description of a silent film" },
    { "type": "url", "id": "feature_captions", "label": "Captions file (.vtt)" },
    { "type": "text", "id": "feature_credit", "label": "Credit (verified only)" },
    { "type": "text", "id": "feature_date", "label": "Recorded (YYYY-MM-DD)" },

    { "type": "header", "content": "The work continues" },
    { "type": "text", "id": "continue_heading", "label": "Heading", "default": "The work continues" },
    { "type": "image_picker", "id": "continue_image", "label": "Image or symbol (optional)" },
    { "type": "text", "id": "continue_alt", "label": "Image alt text" },
