    { "type": "text", "id": "credit_label", "label": "Credit label", "default": "Master" },
    { "type": "text", "id": "empty_text", "label": "Empty media reads", "default": "To supply" },

    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_paper", "label": "Paper (replaces the photograph)", "info": "When set, the header is this paper alone and the photograph is not shown." },
    { "type": "image_picker", "id": "hero_image", "label": "Wide photograph" },
    { "type": "text", "id": "hero_alt", "label": "Alt text", "default": "Warp threads stretched on a handloom" },
    { "type": "range", "id": "hero_focus_x", "label": "Focus, horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "hero_focus_y", "label": "Focus, vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "hero_label", "label": "Small label on the photograph" },
    { "type": "image_picker", "id": "inset_image", "label": "Framed inset (monochrome)" },
    { "type": "text", "id": "inset_alt", "label": "Inset alt text", "default": "Carved wooden printing blocks stacked on workshop shelves" },

    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "heading", "label": "Title (the H1)", "default": "The Masters" },
    { "type": "text", "id": "subline", "label": "Line beneath", "default": "The people. The knowledge. The work." },
    { "type": "text", "id": "col1_label", "label": "Column 1 label", "default": "The cloth" },
    { "type": "richtext", "id": "col1_body", "label": "Column 1", "default": "<p>Textile History dates back to the beginning of human civilization. Hartwick Atelier specializes in hand spun and handwoven fabrics, natural and ayurvedic dyes, and exquisite heritage handwork.</p>" },
    { "type": "image_picker", "id": "col1_symbol", "label": "Column 1 symbol (optional)" },
    { "type": "text", "id": "col2_label", "label": "Column 2 label", "default": "The knowledge" },
    { "type": "richtext", "id": "col2_body", "label": "Column 2", "default": "<p>These artisanal techniques rely on rare knowledge and the natural cycles of the sun, wind and rain.</p>" },
    { "type": "image_picker", "id": "col2_symbol", "label": "Column 2 symbol (optional)" },
    { "type": "text", "id": "col3_label", "label": "Column 3 label", "default": "The handwork" },
    { "type": "richtext", "id": "col3_body", "label": "Column 3", "default": "<p>Each handcrafted piece in the collection is a glimpse into the rich history, intricate process, and generations of skill that have gone into its creation.</p>" },
    { "type": "image_picker", "id": "col3_symbol", "label": "Column 3 symbol (optional)" },

    { "type": "header", "content": "Knowledge band (26 September layout)" },
    { "type": "text", "id": "knowledge_label", "label": "Label", "default": "The knowledge behind the work" },
    { "type": "image_picker", "id": "knowledge_spot", "label": "Swatch hanging from the rings" },
    { "type": "paragraph", "content": "The three columns and their swatches are the Introduction's columns and symbols." },
    { "type": "image_picker", "id": "story_image", "label": "Collage" },
    { "type": "text", "id": "story_alt", "label": "Collage alt text" },
    { "type": "richtext", "id": "story_body", "label": "Text beside the collage" },
    { "type": "header", "content": "Still and movement — the still" },
    { "type": "text", "id": "pair_aria", "label": "Group name for screen readers", "default": "Still and movement" },
    { "type": "image_picker", "id": "still_image", "label": "Photograph" },
    { "type": "text", "id": "still_alt", "label": "Alt text", "default": "A hank of handspun yarn" },
    { "type": "range", "id": "still_focus_x", "label": "Focus, horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "still_focus_y", "label": "Focus, vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "still_number", "label": "Caption number", "default": "01 / Handspinning" },
    { "type": "text", "id": "still_caption", "label": "Caption", "default": "A moment held." },

    { "type": "header", "content": "Still and movement — the film" },
    { "type": "video", "id": "film_video", "label": "Film", "info": "With no film the slot is a still with no play control." },
