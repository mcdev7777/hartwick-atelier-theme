    { "type": "text", "id": "film_title", "label": "Film title (search data)", "default": "Handweaving at the loom" },
    { "type": "richtext", "id": "film_transcript", "label": "Transcript, or a description of a silent film" },
    { "type": "url", "id": "film_captions", "label": "Captions file (.vtt)" },
    { "type": "text", "id": "film_credit", "label": "Credit (verified only)" },
    { "type": "text", "id": "film_date", "label": "Recorded (YYYY-MM-DD)", "info": "Search data needs a date; left empty, the film is not described to search engines." },

    { "type": "header", "content": "The quotation" },
    { "type": "text", "id": "quote_label", "label": "Label", "default": "The khadi spirit" },
    { "type": "textarea", "id": "quote", "label": "Quotation", "default": "If we have the khadi spirit in us,\nwe would surround ourselves with simplicity\nin every walk of life" },
    { "type": "text", "id": "quote_cite", "label": "Attribution", "default": "Mahatma Gandhi" },

    { "type": "header", "content": "The glossary" },
