{%- comment -%} Styles live in assets/ha-sections.css, loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — FOOTER.
  About-page wireframe (Aloha, 15 September 2026): three columns on one row.

      COLLECTION  THE MASTERS  JOURNAL  ABOUT      HARTWICK      INSTAGRAM  CONTACT  PRIVACY
                                                    ATELIER      COOKIE PREFERENCES  LINKEDIN
      © HARTWICK ATELIER

  Aloha: "The main logo should be centred at the bottom of the footer, exactly
  as shown in the wireframe." So the wordmark sits in the middle column, and
  the House symbol — which used to close the footer — moves up into the header
  (snippets/header-logo.liquid). The wordmark is the supplied artwork, never
  live type (LOGO READ ME), drawn with currentColor so it inverts on a dark
  field without a second file.

  Aloha, 15 September (second note): footer type in Porter Light, small, and
  nothing oversized — the wordmark is the 193px she drew, the links 11px.

  Links are blocks, each assigned to the left or the right column, so the
  order and the wording stay editable without touching code. The left column
  can instead take a menu from Admin > Content > Menus — when one is chosen
  it replaces the left-hand blocks.

  One POLICIES link (Aloha, 15 September 2026: "as quiet and considered as
  possible rather than having lots of individual policy links") goes to the
  page that carries every policy under its own anchor — see
  sections/ha-policies.liquid. "Cookie preferences" follows it (Angela,
  14 September 2026) and reopens Shopify's own consent dialog — see
  snippets/ha-cookie-preferences.liquid. It has its own switch so it can be
  shown even when the policies are hidden, since the banner is a legal
  requirement in the UK, EEA and Canada whether or not the policy links are
  wanted here.
{%- endcomment -%}

{%- liquid
  assign on_dark = false
  if section.settings.field == 'peat' or section.settings.field == 'slate'
    assign on_dark = true
  endif
-%}

{%- liquid
  assign footer_layout = section.settings.layout | default: 'columns'
-%}
{%- if footer_layout == 'ledger' -%}
  {%- comment -%}
    THE LEDGER (Aloha, 6 October 2026): a dark footer on her grey paper —
    "for now in black" — with the practical information in clear columns
    after the logo: HARTWICK · DETAILS · SOCIAL · THE REGISTER. The logo is
    her lighter cut in Chalk Blue (assets/ha-footer-wordmark.png), made for
    this dark ground only; everywhere else keeps the SVG wordmark.

    Links are the same blocks as the other layouts: Left → HARTWICK,
    Details → DETAILS, Right → SOCIAL. Policies closes DETAILS; Cookie
    preferences sits on the copyright line (a legal requirement beside the
    banner, so it never disappears with a layout change).

    The Register column is the site's Klaviyo form (assets/ha-klaviyo-form.js,
    source "footer"), with the honeypot and the CASL consent box — the brief
    names only the field and the button, but consent is not optional.
    Button wording: "Join The Register" (Framework v3), not the brief's
    "Sign the Register" — Ivan's call, 6 Oct; flagged to Aloha.
  {%- endcomment -%}
  {%- liquid
    assign ledger_ground = section.settings.ledger_ground
    if ledger_ground == blank or ledger_ground == 'rgba(0,0,0,0)'
      assign ledger_ground = '#000000'
    endif
    if section.settings.ledger_paper != blank
      assign ledger_paper = section.settings.ledger_paper | image_url: width: 2000
    else
      assign ledger_paper = 'ha-footer-paper.jpg' | asset_url
    endif
    assign ledger_veil = 100 | minus: section.settings.ledger_paper_strength
  -%}
  <footer class="ha-section ha-footer ha-footer--ledger" role="contentinfo"
    style="--ha-ledger-ground: {{ ledger_ground }}; --ha-ledger-veil: {{ ledger_veil }}%; --ha-ledger-paper: url('{{ ledger_paper }}');">
    <div class="ha-wrap ha-footer__inner">
      <a class="ha-footer__mark ha-footer__mark--ledger" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
        {%- if section.settings.ledger_logo != blank -%}
          {{ section.settings.ledger_logo | image_url: width: 600 | image_tag: alt: '', width: 206, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'ha-footer-wordmark.png' | asset_url }}" alt="" width="206" height="52" loading="lazy">
        {%- endif -%}
      </a>

      <nav class="ha-footer__cols" aria-label="{{ section.settings.nav_label | escape }}">
        {%- assign ledger_columns = 'left,details,right' | split: ',' -%}
        {%- for column in ledger_columns -%}
          {%- liquid
            case column
              when 'left'
                assign col_heading = section.settings.ledger_heading_left
              when 'details'
                assign col_heading = section.settings.ledger_heading_details
              when 'right'
                assign col_heading = section.settings.ledger_heading_right
            endcase
          -%}
          <div class="ha-footer__col ha-footer__col--{{ column }}">
            {%- if col_heading != blank -%}<p class="ha-footer__heading ha-nav">{{ col_heading }}</p>{%- endif -%}
            <ul class="ha-footer__links ha-footer__links--stack ha-nav" role="list">
              {%- if column == 'left' and section.settings.menu != blank -%}
                {%- for link in section.settings.menu.links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign href = block.settings.url
                    if href == blank
                      case block.settings.social
                        when 'instagram'
                          assign href = settings.social_instagram_link
                        when 'linkedin'
                          assign href = settings.social_linkedin_link
                      endcase
                    endif
                  -%}
                  {%- if block.settings.column == column and block.settings.label != blank -%}
                    <li {{ block.shopify_attributes }}>
                      <a href="{{ href | default: '#' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}{% if href == request.path %} aria-current="page"{% endif %}>{{ block.settings.label }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if column == 'details' and section.settings.show_policies -%}
                <li><a href="{{ section.settings.policies_url | default: '/pages/policies' }}">{{ section.settings.policies_label | default: 'Policies' }}</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      </nav>

      <div class="ha-footer__col ha-footer__col--register" id="footer-register">
        {%- if section.settings.ledger_heading_register != blank -%}<p class="ha-footer__heading ha-nav">{{ section.settings.ledger_heading_register }}</p>{%- endif -%}
        {%- if section.settings.ledger_register_text != blank -%}<p class="ha-footer__lede ha-narrate">{{ section.settings.ledger_register_text }}</p>{%- endif -%}
        {%- form 'customer',
          id: 'FooterRegisterForm',
          class: 'ha-footer__form',
          novalidate: 'novalidate',
          data-nocaptcha: 'true',
          data-ha-klaviyo: '',
          data-company-id: settings.ha_klaviyo_company_id,
          data-list-id: settings.ha_klaviyo_register_list,
          data-source: 'footer',
          data-msg-invalid: section.settings.msg_invalid,
          data-msg-consent: section.settings.msg_consent,
          data-msg-submitting: section.settings.msg_submitting,
          data-msg-success: section.settings.msg_success,
          data-msg-error: section.settings.msg_error
        -%}
          <input type="hidden" name="contact[tags]" value="the-register">
          <p class="ha-footer__message ha-narrate" data-ha-form-status tabindex="-1" role="status" aria-live="polite" hidden></p>

          {%- render 'ha-honeypot', id: 'FooterRegisterHp' -%}

          <div class="ha-footer__field">
            <label class="visually-hidden" for="FooterRegisterEmail">{{ 'newsletter.label' | t }}</label>
            <input id="FooterRegisterEmail" class="ha-footer__input ha-narrate" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'newsletter.label' | t | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" aria-required="true" required>
            <button type="submit" class="ha-footer__submit ha-nav" name="commit">{{ section.settings.ledger_button | default: 'Join The Register' }}</button>
          </div>
          <label class="ha-footer__consent ha-narrate">
            <input type="checkbox" data-ha-consent required aria-required="true">
            <span>{{ section.settings.consent_text | strip_html }}</span>
          </label>

          {%- if form.posted_successfully? -%}
            <p class="ha-footer__message ha-narrate" role="status">{{ 'newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="ha-footer__message ha-narrate is-error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
        <script src="{{ 'ha-klaviyo-form.js' | asset_url }}" defer></script>
      </div>

      <div class="ha-footer__base ha-nav">
        <p class="ha-footer__copy">&copy; {{ shop.name }}</p>
        {%- if section.settings.show_cookie_preferences -%}
          <div class="ha-footer__links">{% render 'ha-cookie-preferences', label: section.settings.cookie_preferences_label %}</div>
        {%- endif -%}
      </div>
    </div>
  </footer>
{%- else -%}
<footer class="ha-section ha-footer ha-footer--{{ footer_layout }}{% unless section.settings.field == 'page' or section.settings.field == blank %} ha-section--field-{{ section.settings.field }}{% endunless %}" role="contentinfo">
  {%- if footer_layout == 'row' -%}
    {%- comment -%}
      THE ROW (Aloha's final homepage, 24 September 2026 — "FINAL HOMEPAGE
      APPROVED - Including bottom footer!!"): the wordmark centred at the top,
      every link on one line beneath it spread across the page, then the
      copyright line at the left. Left-column links come first, then the
      right-column ones, then Policies and Cookie preferences, which is the
      order she draws: COLLECTION … THE CIRCLE · ABOUT · CONTACT · INSTAGRAM ·
      LINKEDIN · OUR POLICIES · COOKIE PREFERENCES.
    {%- endcomment -%}
    <div class="ha-wrap ha-footer__inner">
      <a class="ha-footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
        {%- if on_dark -%}
          {%- render 'ha-wordmark', class: 'ha-wordmark--invert' -%}
        {%- else -%}
          {%- render 'ha-wordmark' -%}
        {%- endif -%}
      </a>
      <nav class="ha-footer__nav" aria-label="{{ section.settings.nav_label | escape }}">
        <ul class="ha-footer__links ha-footer__links--row ha-nav" role="list">
          {%- assign footer_columns = 'left,right' | split: ',' -%}
          {%- for column in footer_columns -%}
            {%- if column == 'left' and section.settings.menu != blank -%}
              {%- for link in section.settings.menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign href = block.settings.url
                  if href == blank
                    case block.settings.social
                      when 'instagram'
                        assign href = settings.social_instagram_link
                      when 'linkedin'
                        assign href = settings.social_linkedin_link
                    endcase
                  endif
                -%}
                {%- if block.settings.column == column and block.settings.label != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ href | default: '#' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}{% if href == request.path %} aria-current="page"{% endif %}>{{ block.settings.label }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.show_policies -%}
            <li><a href="{{ section.settings.policies_url | default: '/pages/policies' }}">{{ section.settings.policies_label | default: 'Policies' }}</a></li>
          {%- endif -%}
          {%- if section.settings.show_cookie_preferences -%}
            <li>{% render 'ha-cookie-preferences', label: section.settings.cookie_preferences_label %}</li>
          {%- endif -%}
        </ul>
      </nav>
      <p class="ha-footer__copy ha-nav">&copy; {{ shop.name }}</p>
    </div>
  {%- else -%}
  <div class="ha-wrap ha-footer__inner">

    <div class="ha-footer__col ha-footer__col--left">
      <nav class="ha-footer__nav" aria-label="{{ section.settings.nav_label | escape }}">
        <ul class="ha-footer__links ha-nav" role="list">
          {%- if section.settings.menu != blank -%}
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.column == 'left' and block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url | default: '#' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.label }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
      <p class="ha-footer__copy ha-nav">&copy; {{ shop.name }}</p>
    </div>

    <div class="ha-footer__col ha-footer__col--mark">
      <a class="ha-footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
        {%- if on_dark -%}
          {%- render 'ha-wordmark', class: 'ha-wordmark--invert' -%}
        {%- else -%}
          {%- render 'ha-wordmark' -%}
        {%- endif -%}
      </a>
    </div>

    <div class="ha-footer__col ha-footer__col--right">
      <ul class="ha-footer__links ha-footer__links--right ha-nav" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.url
            if href == blank
              case block.settings.social
                when 'instagram'
                  assign href = settings.social_instagram_link
                when 'linkedin'
                  assign href = settings.social_linkedin_link
              endcase
            endif
          -%}
          {%- if block.settings.column == 'right' and block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ href | default: '#' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.label }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.show_policies -%}
          <li><a href="{{ section.settings.policies_url | default: '/pages/policies' }}">{{ section.settings.policies_label | default: 'Policies' }}</a></li>
        {%- endif -%}
        {%- if section.settings.show_cookie_preferences -%}
          <li>{% render 'ha-cookie-preferences', label: section.settings.cookie_preferences_label %}</li>
        {%- endif -%}
      </ul>
    </div>

  </div>
  {%- endif -%}
</footer>
{%- endif -%}

{% schema %}
{
  "name": "HA — Footer",
  "tag": "section",
  "class": "ha-section-wrapper",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "columns", "options": [
      { "value": "ledger", "label": "Logo and four columns, dark (6 Oct)" },
      { "value": "row", "label": "Wordmark over one row of links (24 Sep)" },
      { "value": "columns", "label": "Three columns (15 Sep)" }
    ] },
    { "type": "select", "id": "field", "label": "Field colour", "default": "page", "options": [
      { "value": "page", "label": "Page ground" },
      { "value": "peat", "label": "Peat (dark)" },
      { "value": "slate", "label": "Slate (dark)" }
    ] },
    { "type": "link_list", "id": "menu", "label": "Left column menu", "info": "Optional. When a menu is chosen it replaces the left-column link blocks below." },
    { "type": "text", "id": "nav_label", "label": "Navigation label (screen readers)", "default": "Footer" },
    { "type": "checkbox", "id": "show_policies", "label": "Show the Policies link", "default": true, "info": "One link to the page that carries every policy (template: policies)." },
    { "type": "text", "id": "policies_label", "label": "Policies label", "default": "Policies" },
    { "type": "url", "id": "policies_url", "label": "Policies page", "info": "Defaults to /pages/policies." },
    { "type": "checkbox", "id": "show_cookie_preferences", "label": "Show the cookie preferences link", "default": true, "info": "Reopens the cookie banner from Settings > Customer privacy so a visitor can change their choice. Required alongside the banner in the UK, EEA and Canada." },
    { "type": "text", "id": "cookie_preferences_label", "label": "Cookie preferences label", "default": "Cookie preferences" },
    { "type": "header", "content": "Logo and four columns (6 Oct)" },
    { "type": "paragraph", "content": "Used only by the layout \"Logo and four columns, dark\". Left links → first column, Details links → second, Right links → third." },
    { "type": "color", "id": "ledger_ground", "label": "Ground colour", "default": "#000000", "info": "Aloha 6 Oct: black for now." },
    { "type": "image_picker", "id": "ledger_paper", "label": "Paper", "info": "Empty = the grey paper Aloha supplied on 6 Oct." },
    { "type": "range", "id": "ledger_paper_strength", "label": "Paper showing through", "min": 0, "max": 40, "step": 1, "unit": "%", "default": 12 },
    { "type": "image_picker", "id": "ledger_logo", "label": "Logo", "info": "Empty = Aloha's light Chalk Blue logo of 6 Oct (dark ground only)." },
    { "type": "text", "id": "ledger_heading_left", "label": "First column heading", "default": "Hartwick" },
    { "type": "text", "id": "ledger_heading_details", "label": "Second column heading", "default": "Details" },
    { "type": "text", "id": "ledger_heading_right", "label": "Third column heading", "default": "Social" },
    { "type": "text", "id": "ledger_heading_register", "label": "Register column heading", "default": "The Register" },
    { "type": "text", "id": "ledger_register_text", "label": "Register line", "default": "Correspondence from the Hartwick, when there is something worth sending" },
    { "type": "text", "id": "ledger_button", "label": "Register button", "default": "Join The Register" },
    { "type": "richtext", "id": "consent_text", "label": "Consent line", "default": "<p>Yes, add me to The Register. Hartwick Atelier may write to me with The Dispatch and news of each Release. I can leave at any time.</p>", "info": "Required to submit, never pre-ticked (CASL). Same wording as the Register section." },
    { "type": "text", "id": "msg_invalid", "label": "Invalid email", "default": "Please enter a valid email address." },
    { "type": "text", "id": "msg_consent", "label": "Consent not ticked", "default": "Please tick the box to join." },
    { "type": "text", "id": "msg_submitting", "label": "While sending", "default": "One moment…" },
    { "type": "text", "id": "msg_success", "label": "Success", "default": "Thank you. A confirmation is on its way — one click and you are on The Register." },
    { "type": "text", "id": "msg_error", "label": "Service error", "default": "That did not go through. Please try again, or write to contact@hartwickatelier.com." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "select", "id": "column", "label": "Column", "default": "right", "options": [
          { "value": "left", "label": "Left (site pages)" },
          { "value": "details", "label": "Details (four-column layout only)" },
          { "value": "right", "label": "Right (contact and social)" }
        ] },
        { "type": "select", "id": "social", "label": "Address from theme settings", "default": "none", "info": "Used when the Link above is empty. Theme settings > Social media.", "options": [
          { "value": "none", "label": "None" },
          { "value": "instagram", "label": "Instagram" },
          { "value": "linkedin", "label": "LinkedIn" }
        ] },
        { "type": "checkbox", "id": "new_tab", "label": "Open in a new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "HA — Footer",
      "blocks": [
        { "type": "link", "settings": { "label": "Collection", "url": "/collections/all", "column": "left" } },
        { "type": "link", "settings": { "label": "The Masters", "column": "left" } },
        { "type": "link", "settings": { "label": "Journal", "column": "left" } },
        { "type": "link", "settings": { "label": "About", "url": "/pages/about-the-atelier", "column": "left" } },
        { "type": "link", "settings": { "label": "Instagram", "social": "instagram", "new_tab": true, "column": "right" } },
        { "type": "link", "settings": { "label": "Contact", "url": "/pages/contact-us", "column": "right" } },
        { "type": "link", "settings": { "label": "LinkedIn", "social": "linkedin", "new_tab": true, "column": "right" } }
      ]
    }
  ]
}
{% endschema %}
