{%- comment -%} Styles live in assets/ha-sections.css ("JOURNAL"), loaded once in layout/theme.liquid. {%- endcomment -%}

{%- comment -%}
  Hartwick Atelier — THE JOURNAL: the Atelier noticeboard.
  Aloha's artboard, 23 September 2026: a full-width dark block under her
  grain ("BETWEEN STORIES."), with three items across — two photographs
  with a line each, and a third that is words only, larger, set level with
  the photographs. Each item's link sits on one line along the bottom.

  A card's link can be typed, or taken from Theme settings > Social media
  (Instagram, LinkedIn), so the address is kept in one place with the
  footer's. With no address, the words show without a link.
{%- endcomment -%}

{%- unless current_tags -%}
<section class="ha-jnl ha-jnl-board ha-grain-block" style="--ha-jnl-band: {{ section.settings.band_colour }}; --ha-jnl-band-ink: {{ section.settings.band_ink }};">
  <div class="ha-jnl-wrap">
    <div class="ha-jnl-board__head">
      <div>
        <p class="ha-jnl-meta">{{ section.settings.kicker }}</p>
        <h2 class="ha-jnl-display ha-jnl-board__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p class="ha-jnl-board__intro">{{ section.settings.intro | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="ha-jnl-board__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign href = block.settings.link_url
          assign new_tab = false
          case block.settings.link_source
            when 'instagram'
              assign href = settings.social_instagram_link
              assign new_tab = true
            when 'linkedin'
              assign href = settings.social_linkedin_link
              assign new_tab = true
          endcase
        -%}
        <article class="ha-jnl-card{% if block.settings.image == blank %} ha-jnl-card--words{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="ha-jnl-card__media">
              {{ block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 30vw, 100vw',
                  widths: '400, 600, 900, 1200',
                  class: 'ha-jnl-img' }}
            </div>
          {%- endif -%}
          <div class="ha-jnl-card__text">
            <p class="ha-jnl-meta">{{ block.settings.kicker }}</p>
            <h3 class="ha-jnl-card__title">{{ block.settings.title | newline_to_br }}</h3>
            {%- if block.settings.body != blank -%}
              <p class="ha-jnl-card__body">{{ block.settings.body | newline_to_br }}</p>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p class="ha-jnl-meta ha-jnl-card__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
          <div class="ha-jnl-card__foot">
            {%- render 'ha-jnl-link', text: block.settings.link_text, url: href, new_tab: new_tab -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "HA — Journal: noticeboard",
  "tag": "div",
  "class": "ha-jnl-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Atelier noticeboard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Between stories." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Short updates, creative projects and\nconversations from across the table." },
    { "type": "color", "id": "band_colour", "label": "Band colour", "default": "#25231F" },
    { "type": "color", "id": "band_ink", "label": "Text colour", "default": "#E9E4D8" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "No photograph = the words-only item, set larger." },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "01 / Instagram" },
        { "type": "textarea", "id": "title", "label": "Title", "default": "A closer look." },
        { "type": "textarea", "id": "body", "label": "Text" },
        { "type": "text", "id": "note", "label": "Note", "info": "A line in the record voice, e.g. Project preview / Content to follow." },
        { "type": "text", "id": "link_text", "label": "Link text" },
        {
          "type": "select", "id": "link_source", "label": "Link to", "default": "custom",
          "options": [
            { "value": "custom", "label": "The link below" },
            { "value": "instagram", "label": "Instagram (Theme settings > Social media)" },
            { "value": "linkedin", "label": "LinkedIn (Theme settings > Social media)" }
          ]
        },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "HA — Journal: noticeboard", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
