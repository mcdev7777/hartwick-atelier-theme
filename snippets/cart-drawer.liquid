{% comment %}
    Renders cart drawer

    Usage:
    {% render 'cart-drawer' %}

    Hartwick Atelier — THE BAG. Aloha, 22 September 2026:

      "clicking the bag should open a cart drawer from the side"
      Empty:   YOUR BAG IS EMPTY / a short line / VIEW THE COLLECTION
      Filled:  product image, product name (TRIBECA SKIRT), Expression
               underneath, size, quantity, price, remove/edit controls,
               subtotal, checkout.
      "quiet and functional. No upselling clutter, countdowns, discount
       prompts or generic Shopify messaging."

    So Luxe's cart message, cart note, recommendations, payment icons and
    "view cart" button are gone from the drawer (their Theme settings no
    longer reach it). Everything cart.js and cart-drawer.js rely on is kept:
    the custom elements, #CartDrawer, .drawer__inner, #CartDrawer-Form,
    #CartDrawer-Item-N, Drawer-quantity-N, #CartDrawer-LineItemError-N,
    the loading overlays and the live regions — add, change and remove are
    Luxe's working code, untouched.

    The name and the Expression come from ha-product-fact, the one source the
    product page and collection cards also read: the Style name, then the
    Expression, falling back to the two halves of the store title
    ("TRIBECA SKIRT | Handspun Matka Silk, Emerald Changeant").

    Header, width, overlay and close control are shared with the REGION,
    LANGUAGE and THE CIRCLE drawers (snippets/ha-utilities.liquid) through
    the .ha-drawer__* classes.
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer ha-bag{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div class="drawer__inner ha-drawer__inner{% if settings.drawer_margin > 0 %} drawer_with_margin{% endif %}" role="dialog" aria-modal="true" aria-label="{{ settings.ha_bag_title | default: 'Your bag' | escape }}" tabindex="-1">
      <div class="drawer__header ha-drawer__head">
        <span class="dialog-title drawer__title ha-drawer__title">{{ settings.ha_bag_title | default: 'Your bag' | escape }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span>
        <div class="drawer-close-button-wrapper">
          <button class="drawer__close ha-drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
        </div>
      </div>

      {% if cart == empty %}
      <div class="drawer__inner-empty ha-bag-empty">
        <p class="ha-bag-empty__title">{{ settings.ha_bag_empty_title | default: 'Your bag is empty' | escape }}</p>
        {%- if settings.ha_bag_empty_line != blank -%}
          <p class="ha-bag-empty__line">{{ settings.ha_bag_empty_line | escape }}</p>
        {%- endif -%}
        <a class="button ha-bag-empty__cta" href="{{ settings.ha_bag_empty_url | default: routes.collections_url }}">{{ settings.ha_bag_empty_cta | default: 'View the collection' | escape }}</a>
      </div>
      {% endif %}

      <cart-drawer-items {% if cart == empty %}class="is-empty"{% endif %}>
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <ul class="ha-bag__items" role="list">
                  {%- for item in cart.items -%}
                    {%- liquid
                      assign line = item.index | plus: 1
                      assign item_name = ''
                      assign item_expression = ''
                      if item.product
                        capture item_name
                          render 'ha-product-fact', product: item.product, field: 'style'
                        endcapture
                        capture item_expression
                          render 'ha-product-fact', product: item.product, field: 'expression'
                        endcapture
                      endif
                      assign item_name = item_name | strip
                      assign item_expression = item_expression | strip
                      if item_name == blank
                        assign item_name = item.product_title | split: '|' | first | strip
                      endif
                    -%}
                    <li id="CartDrawer-Item-{{ line }}" class="cart-item ha-bag__item">
                      <a href="{{ item.url }}" class="ha-bag__media" tabindex="-1" aria-hidden="true">
                        {%- if item.image -%}
                          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '120px', widths: '120, 180, 240, 300', alt: '' }}
                        {%- endif -%}
                      </a>

                      <div class="ha-bag__details">
                        <div class="ha-bag__top">
                          <div class="ha-bag__names">
                            <a href="{{ item.url }}" class="cart-item__name ha-bag__name">{{ item_name | escape }}</a>
                            {%- if item_expression != blank -%}
                              <p class="ha-bag__expression">{{ item_expression | escape }}</p>
                            {%- endif -%}
                          </div>
                          <div class="ha-bag__price">
                            <div class="loading-overlay hidden">
                              <div class="loading-overlay__spinner">
                                <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                </svg>
                              </div>
                            </div>
                            {%- if item.original_line_price != item.final_line_price -%}
                              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                              <s class="ha-bag__price-was">{{ item.original_line_price | money }}</s>
                              <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                            {%- endif -%}
                            <span class="ha-bag__price-now">{{ item.final_line_price | money }}</span>
                          </div>
                        </div>

                        {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                          <dl class="ha-bag__options">
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="ha-bag__option">
                                  <dt>{{ option.name }}</dt>
                                  <dd>{{ option.value }}</dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}
                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="ha-bag__option">
                                  <dt>{{ property.first }}</dt>
                                  <dd>{{ property.last }}</dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if item.selling_plan_allocation != nil -%}
                              <div class="ha-bag__option"><dd>{{ item.selling_plan_allocation.selling_plan.name }}</dd></div>
                            {%- endif -%}
                          </dl>
                        {%- endif -%}

                        <div class="ha-bag__controls">
                          <div class="ha-bag__qty">
                            <span class="ha-bag__qty-label" aria-hidden="true">{{ 'hartwick.bag.quantity' | t }}</span>
                            <quantity-input class="quantity ha-bag__stepper">
                              <button class="quantity__button no-js-hidden" name="minus" type="button">
                                <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item_name | escape }}</span>
                                {% render 'icon-minus' %}
                              </button>
                              <input class="quantity__input"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                min="0"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item_name | escape }}"
                                id="Drawer-quantity-{{ line }}"
                                data-index="{{ line }}"
                              >
                              <button class="quantity__button no-js-hidden" name="plus" type="button">
                                <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item_name | escape }}</span>
                                {% render 'icon-plus' %}
                              </button>
                            </quantity-input>
                          </div>
                          <div class="ha-bag__actions">
                            <a class="ha-bag__action" href="{{ item.url }}">{{ 'hartwick.bag.edit' | t }}<span class="visually-hidden"> {{ item_name | escape }}</span></a>
                            <cart-remove-button id="CartDrawer-Remove-{{ line }}" data-index="{{ line }}">
                              <button type="button" class="ha-bag__action" aria-label="{{ 'sections.cart.remove_title' | t }} {{ item_name | escape }}">{{ 'sections.cart.remove_title' | t }}</button>
                            </cart-remove-button>
                          </div>
                        </div>

                        <div id="CartDrawer-LineItemError-{{ line }}" class="cart-item__error ha-bag__error" role="alert">
                          <span class="cart-item__error-text"></span>
                        </div>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
          </div>
          <div id="CartDrawer-CartErrors" class="ha-bag__error" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer ha-bag__footer">
        <div class="cart-drawer__footer">
          <div class="totals ha-bag__totals" role="status">
            <div class="ha-bag__total-row">
              <span>{{ 'sections.cart.headings.subtotal' | t }}</span>
              <span class="totals__subtotal-value">{{ cart.items_subtotal_price | money }}</span>
            </div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="ha-bag__total-row ha-bag__total-row--quiet">
                  <span>{{ discount.title | escape }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
              <div class="ha-bag__total-row">
                <span>{{ 'sections.cart.headings.total' | t }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
            {%- endif -%}
          </div>
          {%- if settings.ha_bag_tax_note -%}
          <p class="tax-note ha-bag__note">
            {%- if cart.taxes_included -%}
              {{ 'hartwick.bag.tax_included' | t }}
            {%- else -%}
              {{ 'hartwick.bag.tax_excluded' | t }}
            {%- endif -%}
          </p>
          {%- endif -%}
        </div>

        <div class="cart__ctas ha-bag__ctas">
          <noscript>
            <button type="submit" class="cart__update-button button button--secondary" form="CartDrawer-Form">
              {{ 'sections.cart.update' | t }}
            </button>
          </noscript>
          <button type="submit" id="CartDrawer-Checkout" class="cart__checkout-button button" name="checkout" form="CartDrawer-Form"{% if cart == empty %} disabled{% endif %}>
            {{ 'sections.cart.checkout' | t }}
          </button>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
