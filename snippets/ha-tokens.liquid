{%- comment -%}
  Hartwick Atelier — brand tokens.
  Source: BRANDING/Colour/"HA Brand Book Colour Language.pdf" (Material Archive palette, p16-17).

  Every Hartwick section reads these variables. Nothing else should contain a raw hex value,
  so the palette can be finalised from Theme settings > Hartwick — Material Archive without
  touching section code.

  Rendered from layout/theme.liquid AFTER 'global-theme-styles' so it can override Luxe.
{%- endcomment -%}

{%- liquid
  assign soot  = settings.ha_soot_black | default: '#0B0603'
  assign peat  = settings.ha_peat_fibre | default: '#332820'

  # Brand book p17: tints are the colour mixed with WHITE at 66% / 33%.
  # Computed here rather than with CSS color-mix() so the value is a plain
  # rgb() every browser understands — a custom property holding an
  # unsupported function resolves to nothing, it does not fall back.
  assign soot_r = soot | color_extract: 'red'
  assign soot_g = soot | color_extract: 'green'
  assign soot_b = soot | color_extract: 'blue'
  assign peat_r = peat | color_extract: 'red'
  assign peat_g = peat | color_extract: 'green'
  assign peat_b = peat | color_extract: 'blue'

  # Sand: the page ground pulled 6% toward peat. The About-page wireframe
  # (15 Sep 2026) sets "A journey into the House" on a band one step darker
  # than the page, and none of the eight archive colours is that step.
  assign ground = settings.ha_page_ground | default: '#F3F0E7'
  assign sand_r = ground | color_extract: 'red'   | times: 0.94
  assign sand_g = ground | color_extract: 'green' | times: 0.94
  assign sand_b = ground | color_extract: 'blue'  | times: 0.94
  assign sand_r = peat_r | times: 0.06 | plus: sand_r | round
  assign sand_g = peat_g | times: 0.06 | plus: sand_g | round
  assign sand_b = peat_b | times: 0.06 | plus: sand_b | round
-%}

{% style %}
  :root {
    /* --- the eight Material Archive colours --- */
    --ha-soot-black:    {{ soot }};
    --ha-cutch-resin:   {{ settings.ha_cutch_resin   | default: '#541F00' }};
    --ha-inkstone:      {{ settings.ha_inkstone      | default: '#2D2E38' }};
    --ha-peat-fibre:    {{ peat }};
    --ha-loden-moss:    {{ settings.ha_loden_moss    | default: '#B2AA72' }};
    --ha-bare-clay:     {{ settings.ha_bare_clay     | default: '#DEB6BE' }};
    --ha-mordant-amber: {{ settings.ha_mordant_amber | default: '#D5A040' }};
    --ha-chalk-blue:    {{ settings.ha_chalk_blue    | default: '#E9F3FF' }};

    /* --- grounds ---
       The page runs on ONE ground, not the alternating colour bands the revised
       wireframe drew — those fills were placeholder, and Aloha asked that only
       the structure and positions be taken from that file, not its colours.
       Aloha, 23 September 2026: "no white on the background, please use again
       f3f0e7 colour throughout" — #F3F0E7 (was the placeholder #F2EFE9).
       Changing this one field restyles the site.

       The --ha-field-* tokens remain as an available capability — a section can
       still opt into a field with its `field` setting — but nothing on the
       product page reaches for one; every section sits on the page ground. */
    --ha-page-ground:   {{ settings.ha_page_ground   | default: '#F3F0E7' }};
    --ha-field-dark:    {{ settings.ha_field_dark    | default: '#332820' }};
    /* The "+" panels (Aloha, 8 October 2026): "Just a simple background
       colour of #F8F5ED." Theme settings > Colours, like the page ground. */
    --ha-info-panel:    {{ settings.ha_info_panel    | default: '#F8F5ED' }};
    --ha-field-white:   {{ settings.ha_page_ground   | default: '#F3F0E7' }};
    --ha-field-botanical: var(--ha-loden-moss);
    --ha-field-blush:   var(--ha-bare-clay);
    --ha-field-slate:   var(--ha-inkstone);
    --ha-field-sand:    rgb({{ sand_r }}, {{ sand_g }}, {{ sand_b }});
    /* The Register page (Aloha, 21 September 2026): a wine band and an
       envelope in paper. Peat's channels are exposed so the envelope's folds
       can be shaded with rgba() over whatever paper colour is set. */
    --ha-field-correspondence: {{ settings.ha_correspondence_field | default: '#502F37' }};
    --ha-paper:         {{ settings.ha_paper | default: '#EEE8D4' }};
    --ha-peat-rgb:      {{ peat_r }}, {{ peat_g }}, {{ peat_b }};
    /* Aloha's remade homepage (23 September 2026): the opening and the story
       cards are a darker sheet than the page; the sections are bound by a dark
       bar with binder rings. */
    --ha-paper-panel:   {{ settings.ha_paper_panel | default: '#EEECE2' }};
    --ha-binding-bar:   {{ settings.ha_binding_bar | default: '#392B24' }};
    /* The divider (Aloha, 25 September 2026): "Whenever a dividing line runs
       across a section of the website, please replace the thin rule with the
       thicker brown line we've established" — the binding bar's own colour and
       thickness (16 on 1440). Rules inside a section (list rows, tables,
       ruled buttons) stay hairlines. */
    --ha-divider-w:     clamp(0.8rem, 1.11vw, 1.6rem);
    --ha-divider:       var(--ha-divider-w) solid var(--ha-binding-bar);
    --ha-scrollbar-thumb: {{ settings.ha_scrollbar_color | default: '#69645F' }};
    /* Aloha's pencil marks (23 September 2026) — alpha masks cut from her
       sheet by scripts/make-pencil-marks.py; ha-sections.css "PENCIL MARKS". */
    --ha-mark-arrow:  url("{{ 'ha-mark-arrow.svg' | asset_url }}");
    --ha-mark-oval:   url("{{ 'ha-mark-oval.svg' | asset_url }}");
    --ha-mark-ring-1: url("{{ 'ha-mark-ring-1.svg' | asset_url }}");
    --ha-mark-ring-2: url("{{ 'ha-mark-ring-2.svg' | asset_url }}");
    /* Aloha's grain layer on dark blocks (Journal artboard, 23 September
       2026): her Grain.png, cut to a 320px tile at the scale she placed it
       (assets/ha-grain-block.svg; SVG so the CDN does not re-encode it) —
       ha-sections.css ".ha-grain-block". Her image is grey at 60% alpha;
       the layer strength multiplies that, as her 32% layer did. */
    --ha-grain-tile: url("{{ 'ha-grain-block.svg' | asset_url }}");
    /* The same tile with the Register page's 30% baked in (0.18 = 30% of her
       60%-alpha grain), for the site-wide grain (Aloha, 25 September 2026:
       "apply the grain layer as a background across EVERY section of the
       website, following the same treatment already used on The Register
       page"). Baked into the file because a background image cannot take an
       opacity; ha-sections.css "GRAIN EVERYWHERE". */
    --ha-grain-page: url("{{ 'ha-grain-page.svg' | asset_url }}");
    /* The Circle's mark (Aloha, 24 September 2026: "Dye blotch = The Circle"):
       her yellow dye spot, 128px WebP with transparency. */
    --ha-circle-blotch: url("{{ 'ha-circle-blotch.webp' | asset_url }}");
    --ha-grain-strength: {{ settings.ha_grain_block | default: 32 | times: 0.6 | divided_by: 100.0 }};
    --ha-grain-register: {{ settings.ha_grain_register | default: 30 | times: 0.6 | divided_by: 100.0 }};

    /* --- tint system (100 / 66 / 33 / 0 against white) --- */
    --ha-soot-66: rgb({{ soot_r | times: 0.66 | plus: 86.7 | round }}, {{ soot_g | times: 0.66 | plus: 86.7 | round }}, {{ soot_b | times: 0.66 | plus: 86.7 | round }});
    --ha-soot-33: rgb({{ soot_r | times: 0.33 | plus: 170.85 | round }}, {{ soot_g | times: 0.33 | plus: 170.85 | round }}, {{ soot_b | times: 0.33 | plus: 170.85 | round }});
    --ha-peat-66: rgb({{ peat_r | times: 0.66 | plus: 86.7 | round }}, {{ peat_g | times: 0.66 | plus: 86.7 | round }}, {{ peat_b | times: 0.66 | plus: 86.7 | round }});
    --ha-peat-33: rgb({{ peat_r | times: 0.33 | plus: 170.85 | round }}, {{ peat_g | times: 0.33 | plus: 170.85 | round }}, {{ peat_b | times: 0.33 | plus: 170.85 | round }});

    /* Placeholder field. 72% peat is the lightest tint that still carries
       Chalk Blue label text at AA (5.1:1); the 66% tint measures 4.3:1. */
    --ha-peat-72: rgb({{ peat_r | times: 0.72 | plus: 71.4 | round }}, {{ peat_g | times: 0.72 | plus: 71.4 | round }}, {{ peat_b | times: 0.72 | plus: 71.4 | round }});

    /* --- semantic roles: sections use THESE, never a colour name --- */
    --ha-text:        var(--ha-soot-black);
    --ha-text-quiet:  var(--ha-soot-66);
    --ha-text-invert: var(--ha-chalk-blue);

    /* Two rule weights, measured off Wireframe 04.

       The quiet hairline that carries the record tables, the accordion rows and
       the header measures #E0DEDC on the page ground and #453B33 on the peat
       field — the same 14% of the ink in both cases. So it is declared as an
       ALPHA rather than as a tint: one value that stays correct on five
       different fields, where a fixed tint would go muddy on four of them.
       .ha-section--dark re-declares it against Chalk Blue.

       The structural border — the size buttons — is near-solid ink and is a
       separate token, because the two are not interchangeable: the size a
       visitor is choosing must not be drawn in table-rule grey. */
    --ha-rule:   rgba({{ soot_r }}, {{ soot_g }}, {{ soot_b }}, 0.14);
    --ha-border: rgba({{ soot_r }}, {{ soot_g }}, {{ soot_b }}, 0.85);

    /* Accent colours fail WCAG AA as text (Mordant Amber 2.35:1, Loden Moss 2.36:1
       against white). They are surfaces, rules and marks only — never body copy,
       link text or button labels. */
    --ha-accent-surface: var(--ha-mordant-amber);
    --ha-botanical:      var(--ha-loden-moss);

    /* Provisional imagery, until Angela's assets land. */
    --ha-placeholder-field: var(--ha-peat-72);

    /* ==================================================================
       IMAGE RESTRAINT  —  Aloha, 4 September 2026
       "In a few sections, the images feel oversized for the space, which
        makes them dominate the layout. Images are important for us, but they
        shouldn't overwhelm the page. […] The Handcrafted Modern site is a
        good reference for proportion and how imagery supports the page
        without taking over."

       One ceiling, expressed against the viewport rather than in pixels, so
       the restraint holds on a 13" laptop and on a 27" monitor alike. A
       picture that cannot exceed roughly half the screen can support a page;
       one that fills the screen becomes the page.

       Every large figure on the product page reads this. Held as a setting
       because Aloha is re-editing the photographs after Monday's meeting with
       Angela and will want to retune once the real crops land.
       ================================================================== */
    --ha-media-cap: {{ settings.ha_media_cap | default: 56 }}vh;


    /* ==================================================================
       TYPE SCALE — Aloha's 22 September table is the size rule, and it still
       stands. The 24 September changes (the five roles, the header and the
       Register box) set typefaces and weights only; she gave no new sizes
       with them. On 24 September the scale was briefly re-measured from her
       final homepage artboard. Ivan reversed that the same day: "if she only
       gave us the design image with big font sizes, don't accept the font
       sizes in the design image. we must follow the given font rules."
       Sizes change only when she writes new ones. The one new row since
       22 September is navigation, --ha-t-nav, which is a slider of its own
       and defaults to her 11.

       ---------------------------------------------------------------------
       TYPE SCALE  —  Aloha, 22 September 2026 ("web text sizes")

       "We need to heavily decrease the sizes of our texts […] quite a lot of
        the text feels oversized so we're losing some of the editorial
        hierarchy. […] Can we establish a consistent typography system across
        the theme rather than adjusting sections individually? […] The overall
        aim is smaller and calmer. Photography, spacing and information
        structure should create the hierarchy rather than oversized typography."

       THIS BLOCK IS THE SYSTEM. Her table has one row per text category; each
       row is one token below, and every rule in the theme points at a token
       rather than at a number. Nothing outside this file sets a type size —
       not a section, not a Luxe component, not the header. That is what makes
       "set globally rather than manually resizing each block" true rather than
       aspirational, and it is why the earlier multiplier idiom
       (`calc(var(--ha-t-editorial) * 1.7)`) has been removed everywhere: a
       heading derived from another heading cannot be governed from one table.

       WHAT CHANGED, AND WHY THE OLD NOTES BELOW ARE GONE
       The 4 September tuning reasoned from x-heights — Junicode reads about a
       fifth smaller than a sans at the same nominal size, so body copy was set
       at 15px of Junicode to match Bode's 12px of Unica by eye. That reasoning
       is now spent, because Aloha's new table assigns the FONT and the SIZE
       together in the same row: body copy is 13px of the condensed mono (retired),
       whose x-height (0.536em) is larger than Unica's, and Junicode appears
       only at 13px and above (Expression, intro, H3). The table is internally
       consistent on its own terms, so it is taken literally here.

       Her font hierarchy, applied as the voice each token carries:
         Porter   — major titles and product names        (hero, h1, h2, style)
         Junicode — editorial headings, Expressions,
                    numbers, selected introductions       (h3, intro, expression)
         the condensed mono (retired) — body copy, navigation,
                    functional information, captions, data (everything else)

       SUPERSEDED: the 3 September floor "labels and technical information never
       below 12px on mobile". The new table sets small labels, captions and
       metadata at 10px on both breakpoints and legal text at 9px, so the
       `at_least: 12` guard has been removed. 9px is small; it is applied only
       to the copyright/legal line, exactly as the table specifies.

       Mobile first; the desktop values take over at 990px, Luxe's own
       breakpoint. Sizes are rem against Luxe's 10px root (1.3rem = 13px) so a
       visitor who has raised their browser's default text size still gets it.
       Every row is a slider in Theme settings > Hartwick — Material Archive >
       Type scale, so the scale stays Aloha's to re-tune without a developer.
       ================================================================== */

    /* 2 October 2026, later: the sizes measured from her Circle board (hero 77,
       body 17…) were reverted at Aloha's request ("all the text looks so big
       again … recover the original font sizes"). The 1 October table below
       stands; the faces of 2 October stay. The numbers row keeps the Circle
       page's 1 October size (three times the meta row). */
    /* 1 October 2026 (Ivan's fix list, 3: "title fonts need to be a little
       bigger and stronger"): the four title rows up one step — desktop hero
       32→36, h1 26→30, h2 20→23, h3 16→18; phone 28→30, 23→25, 18→20, 15→16.
       Stronger: titles in Junicode Regular (400), the rule at the end of
       ha-sections.css ("TITLES, 1 OCTOBER"). Body copy stays Light. */
    /* --- display: Porter ------------------------------------------------ */
    --ha-t-hero:       {{ settings.ha_t_hero_m       | default: 30 | divided_by: 10.0 }}rem;
    --ha-t-h1:         {{ settings.ha_t_h1_m         | default: 25 | divided_by: 10.0 }}rem;
    --ha-t-h2:         {{ settings.ha_t_h2_m         | default: 20 | divided_by: 10.0 }}rem;
    /* --- editorial: Junicode -------------------------------------------- */
    --ha-t-h3:         {{ settings.ha_t_h3_m         | default: 16 | divided_by: 10.0 }}rem;
    --ha-t-intro:      {{ settings.ha_t_intro_m      | default: 14 | divided_by: 10.0 }}rem;
    --ha-t-expression: {{ settings.ha_t_expression_m | default: 12 | divided_by: 10.0 }}rem;
    /* --- record: the mono (now Typewriter) (normal width since 24 Sep) ------------ */
    --ha-t-body:       {{ settings.ha_t_body_m       | default: 13 | divided_by: 10.0 }}rem;
    --ha-t-detail:     {{ settings.ha_t_detail_m     | default: 12 | divided_by: 10.0 }}rem;
    --ha-t-price:      {{ settings.ha_t_price_m      | default: 12 | divided_by: 10.0 }}rem;
    --ha-t-ui:         {{ settings.ha_t_ui_m         | default: 11 | divided_by: 10.0 }}rem;
    --ha-t-label:      {{ settings.ha_t_label_m      | default: 10 | divided_by: 10.0 }}rem;
    --ha-t-meta:       {{ settings.ha_t_meta_m       | default: 10 | divided_by: 10.0 }}rem;
    --ha-t-legal:      {{ settings.ha_t_legal_m      | default: 9  | divided_by: 10.0 }}rem;
    /* The product name is a Porter surface and sits on its own row in the
       table (16 / 15), one step above H3 rather than on the H2 line. */
    --ha-t-style:      {{ settings.ha_t_style_m      | default: 15 | divided_by: 10.0 }}rem;
    --ha-t-nav:        {{ settings.ha_t_nav_m        | default: 11 | divided_by: 10.0 }}rem;
    /* standalone numbering (01 02 03 over the Circle columns): 3 × meta, as 1 October */
    --ha-t-num:        {{ settings.ha_t_num_m        | default: 30 | divided_by: 10.0 }}rem;

    /* Roles the table names separately but sizes identically to a row above.
       They are aliases rather than sliders so the two can never drift apart
       by accident, and so a future instruction that splits them has one
       obvious place to land. */
    --ha-t-caption:        var(--ha-t-meta);        /* image captions      10 */
    /* navigation is its own row since 24 September (Porter Medium 12) */
    --ha-t-button:         var(--ha-t-ui);          /* button text         11 */
    --ha-t-accordion:      var(--ha-t-ui);          /* accordion headings  11 */
    --ha-t-footer:         var(--ha-t-ui);          /* footer links/body   11 */
    --ha-t-footer-heading: var(--ha-t-label);       /* footer headings     10 */

    /* --- line heights, per her table ------------------------------------
       Unitless, so they travel with whatever size the token above resolves to
       and a slider move cannot break the setting. */
    --ha-t-lh-hero:       1.08;   /* 1.05–1.1 */
    --ha-t-lh-h1:         1.1;
    --ha-t-lh-h2:         1.15;
    --ha-t-lh-h3:         1.25;
    --ha-t-lh-intro:      1.5;
    --ha-t-lh-expression: 1.35;
    --ha-t-lh-style:      1.2;
    --ha-t-lh-detail:     1.5;
    --ha-t-lh-price:      1.3;
    --ha-t-lh-ui:         1.3;
    --ha-t-lh-button:     1;
    --ha-t-lh-nav:        1.2;
    --ha-t-lh-label:      1.2;
    --ha-t-lh-meta:       1.4;
    --ha-t-lh-footer:     1.5;
    --ha-t-lh-legal:      1.4;
    /* Body is the one line height Aloha gave as a range (1.55–1.65) and the
       one most worth being able to nudge, so it stays a slider. It used to be
       a LENGTH in px, consumed as `calc(--ha-t-body-lh / --ha-t-body)`; it is
       a plain ratio now, and those calc() call sites have been replaced. */
    --ha-t-body-lh:    {{ settings.ha_t_body_lh | default: 160 | divided_by: 100.0 }};

    /* Tracking travels with size: the record voice needs it, a 32px display
       heading does not. Declared here so a section never invents its own. */
    --ha-track-meta:  0.14em;
    --ha-track-label: 0.12em;
    --ha-track-ui:    0.14em;
  }

  /* 1 October 2026 (Ivan: "on the desktop mode, make the current whole
     fonts a little bit bigger, really little bigger, and keep the current
     font sizes on the mobile mode"): every desktop row +1px — hero 37, h1 31,
     h2 24, h3 19, intro 16, expression 14, body 14, detail 13, price 13,
     ui 12, label 11, meta 11, legal 10, style 17, nav 12. Phone rows as they were. */
  @media screen and (min-width: 990px) {
    :root {
      --ha-t-hero:       {{ settings.ha_t_hero_d       | default: 37 | divided_by: 10.0 }}rem;
      --ha-t-h1:         {{ settings.ha_t_h1_d         | default: 31 | divided_by: 10.0 }}rem;
      --ha-t-h2:         {{ settings.ha_t_h2_d         | default: 24 | divided_by: 10.0 }}rem;
      --ha-t-h3:         {{ settings.ha_t_h3_d         | default: 19 | divided_by: 10.0 }}rem;
      --ha-t-intro:      {{ settings.ha_t_intro_d      | default: 16 | divided_by: 10.0 }}rem;
      --ha-t-expression: {{ settings.ha_t_expression_d | default: 14 | divided_by: 10.0 }}rem;
      --ha-t-body:       {{ settings.ha_t_body_d       | default: 14 | divided_by: 10.0 }}rem;
      --ha-t-detail:     {{ settings.ha_t_detail_d     | default: 13 | divided_by: 10.0 }}rem;
      --ha-t-price:      {{ settings.ha_t_price_d      | default: 13 | divided_by: 10.0 }}rem;
      --ha-t-ui:         {{ settings.ha_t_ui_d         | default: 12 | divided_by: 10.0 }}rem;
      --ha-t-label:      {{ settings.ha_t_label_d      | default: 11 | divided_by: 10.0 }}rem;
      --ha-t-meta:       {{ settings.ha_t_meta_d       | default: 11 | divided_by: 10.0 }}rem;
      --ha-t-legal:      {{ settings.ha_t_legal_d      | default: 10  | divided_by: 10.0 }}rem;
      --ha-t-style:      {{ settings.ha_t_style_d      | default: 17 | divided_by: 10.0 }}rem;
      --ha-t-nav:        {{ settings.ha_t_nav_d        | default: 12 | divided_by: 10.0 }}rem;
      --ha-t-num:        {{ settings.ha_t_num_d        | default: 33 | divided_by: 10.0 }}rem;
    }
  }

  {%- comment -%}
    THE LUXE BRIDGE.

    Luxe funnels its own typography — headings, body, buttons, captions, cart,
    badges, dialogs — through the --font-* custom properties that
    `global-theme-styles` builds out of the theme's font-size settings. This
    snippet renders AFTER that one, so re-declaring them here points every
    native section at Aloha's table without touching a single Luxe stylesheet
    and without a theme update overwriting the work.

    Without this bridge the site would have two typographies: a small, calm
    Hartwick one and an untouched Luxe one running the header, the footer, the
    cart, the product cards and the customer account pages. That split is
    exactly what "a consistent typography system across the theme" rules out.

    Luxe has a tablet step at 750px that the Hartwick scale does not; tablet
    takes the desktop value, since the table has only two columns.
  {%- endcomment -%}
  :root {
    /* body copy — 13px */
    --font-body-base-size-mobile:  {{ settings.ha_t_body_m   | default: 13 }}px;
    --font-body-base-size-tablet:  {{ settings.ha_t_body_d   | default: 14 }}px;
    --font-body-base-size-desktop: {{ settings.ha_t_body_d   | default: 14 }}px;
    --base-line-height: {{ settings.ha_t_body_lh | default: 160 | divided_by: 100.0 }};

    /* interface text — 11px. Luxe's "small" and "micro" steps are the label
       and caption row, 10px. */
    --font-ui-size-mobile:        {{ settings.ha_t_ui_m    | default: 11 }}px;
    --font-ui-size-desktop:       {{ settings.ha_t_ui_d    | default: 12 }}px;
    --font-ui-size-small-mobile:  {{ settings.ha_t_label_m | default: 10 }}px;
    --font-ui-size-small-desktop: {{ settings.ha_t_label_d | default: 11 }}px;
    --font-size-micro-mobile:     {{ settings.ha_t_label_m | default: 10 }}px;
    --font-size-micro-desktop:    {{ settings.ha_t_label_d | default: 11 }}px;

    /* captions and metadata — 10px */
    --font-caption-size-mobile:  {{ settings.ha_t_meta_m | default: 10 }}px;
    --font-caption-size-desktop: {{ settings.ha_t_meta_d | default: 11 }}px;

    /* product badges — a label */
    --font-size-product-badge-mobile:  {{ settings.ha_t_label_m | default: 10 }}px;
    --font-size-product-badge-desktop: {{ settings.ha_t_label_d | default: 11 }}px;

    /* cart and dialogs are functional information — 12px */
    --font-size-cart-drawer-mobile:  {{ settings.ha_t_detail_m | default: 12 }}px;
    --font-size-cart-drawer-desktop: {{ settings.ha_t_detail_d | default: 13 }}px;
    --dialog-title-size-mobile:  {{ settings.ha_t_h3_m | default: 16 }}px;
    --dialog-title-size-tablet:  {{ settings.ha_t_h3_d | default: 19 }}px;
    --dialog-title-size-desktop: {{ settings.ha_t_h3_d | default: 19 }}px;

    /* FORM FIELDS ARE THE ONE DELIBERATE EXCEPTION on mobile. iOS Safari zooms
       the page whenever a focused input is under 16px, and the zoom does not
       reverse when the field is left — a visitor filling in The Register would
       be stranded at 1.3x with the layout broken. 16px on phones, the table's
       body size on everything else. The same reason is why the Hartwick form
       rules read `max(var(--ha-t-body), 1.6rem)`. */
    --font-form-placeholder-size-mobile:  16px;
    --font-form-placeholder-size-desktop: {{ settings.ha_t_body_d | default: 14 }}px;

    /* buttons — 11px, line height 1 */
    --buttons-font-size-mobile:  {{ settings.ha_t_ui_m | default: 11 }}px;
    --buttons-font-size-desktop: {{ settings.ha_t_ui_d | default: 12 }}px;

    /* Luxe's heading ladder. h1–h3 are Aloha's rows. h4 takes the intro size,
       h5 the body size and h6 the label size, which is where Luxe's own
       templates use them (h6 is Luxe's uppercase eyebrow). h0/hxl/hxxl are
       Luxe's oversize display steps — every one of them collapses onto the
       hero row, because the table has no size above it. */
    --font-h1-size-mobile:  {{ settings.ha_t_h1_m | default: 25 }}px;
    --font-h1-size-tablet:  {{ settings.ha_t_h1_d | default: 31 }}px;
    --font-h1-size-desktop: {{ settings.ha_t_h1_d | default: 31 }}px;
    --font-h2-size-mobile:  {{ settings.ha_t_h2_m | default: 20 }}px;
    --font-h2-size-tablet:  {{ settings.ha_t_h2_d | default: 24 }}px;
    --font-h2-size-desktop: {{ settings.ha_t_h2_d | default: 24 }}px;
    --font-h3-size-mobile:  {{ settings.ha_t_h3_m | default: 16 }}px;
    --font-h3-size-tablet:  {{ settings.ha_t_h3_d | default: 19 }}px;
    --font-h3-size-desktop: {{ settings.ha_t_h3_d | default: 19 }}px;
    --font-h4-size-mobile:  {{ settings.ha_t_intro_m | default: 14 }}px;
    --font-h4-size-tablet:  {{ settings.ha_t_intro_d | default: 16 }}px;
    --font-h4-size-desktop: {{ settings.ha_t_intro_d | default: 16 }}px;
    --font-h5-size-mobile:  {{ settings.ha_t_body_m | default: 13 }}px;
    --font-h5-size-tablet:  {{ settings.ha_t_body_d | default: 14 }}px;
    --font-h5-size-desktop: {{ settings.ha_t_body_d | default: 14 }}px;
    --font-h6-size-mobile:  {{ settings.ha_t_label_m | default: 10 }}px;
    --font-h6-size-tablet:  {{ settings.ha_t_label_d | default: 11 }}px;
    --font-h6-size-desktop: {{ settings.ha_t_label_d | default: 11 }}px;
    --font-h0-size-mobile:   {{ settings.ha_t_hero_m | default: 30 }}px;
    --font-h0-size-tablet:   {{ settings.ha_t_hero_d | default: 37 }}px;
    --font-h0-size-desktop:  {{ settings.ha_t_hero_d | default: 37 }}px;
    --font-hxl-size-mobile:  {{ settings.ha_t_hero_m | default: 30 }}px;
    --font-hxl-size-tablet:  {{ settings.ha_t_hero_d | default: 37 }}px;
    --font-hxl-size-desktop: {{ settings.ha_t_hero_d | default: 37 }}px;
    --font-hxxl-size-mobile:  {{ settings.ha_t_hero_m | default: 30 }}px;
    --font-hxxl-size-tablet:  {{ settings.ha_t_hero_d | default: 37 }}px;
    --font-hxxl-size-desktop: {{ settings.ha_t_hero_d | default: 37 }}px;
  }
{% endstyle %}
