{%- comment -%}
  Hartwick Atelier — brand tokens.
  Source: BRANDING/Colour/"HA Brand Book Colour Language.pdf" (Material Archive palette, p16-17).

  Every Hartwick section reads these variables. Nothing else should contain a raw hex value,
  so the palette can be finalised from Theme settings > Hartwick — Material Archive without
  touching section code.

  Rendered from layout/theme.liquid AFTER 'global-theme-styles' so it can override Luxe.
{%- endcomment -%}

{%- liquid
  assign soot  = settings.ha_soot_black | default: '#0B0603'
  assign peat  = settings.ha_peat_fibre | default: '#332820'

  # Brand book p17: tints are the colour mixed with WHITE at 66% / 33%.
  # Computed here rather than with CSS color-mix() so the value is a plain
  # rgb() every browser understands — a custom property holding an
  # unsupported function resolves to nothing, it does not fall back.
  assign soot_r = soot | color_extract: 'red'
  assign soot_g = soot | color_extract: 'green'
  assign soot_b = soot | color_extract: 'blue'
  assign peat_r = peat | color_extract: 'red'
  assign peat_g = peat | color_extract: 'green'
  assign peat_b = peat | color_extract: 'blue'
-%}

{% style %}
  :root {
    /* --- the eight Material Archive colours --- */
    --ha-soot-black:    {{ soot }};
    --ha-cutch-resin:   {{ settings.ha_cutch_resin   | default: '#541F00' }};
    --ha-inkstone:      {{ settings.ha_inkstone      | default: '#2D2E38' }};
    --ha-peat-fibre:    {{ peat }};
    --ha-loden-moss:    {{ settings.ha_loden_moss    | default: '#B2AA72' }};
    --ha-bare-clay:     {{ settings.ha_bare_clay     | default: '#DEB6BE' }};
    --ha-mordant-amber: {{ settings.ha_mordant_amber | default: '#D5A040' }};
    --ha-chalk-blue:    {{ settings.ha_chalk_blue    | default: '#E9F3FF' }};

    /* --- grounds ---
       The page runs on ONE ground, not the alternating colour bands the revised
       wireframe drew — those fills were placeholder, and Aloha asked that only
       the structure and positions be taken from that file, not its colours.
       #F2EFE9 stays the placeholder ground pending her confirmation (the logo
       rules name Chalk Blue instead). Changing this one field restyles the site.

       The --ha-field-* tokens remain as an available capability — a section can
       still opt into a field with its `field` setting — but nothing on the
       product page reaches for one; every section sits on the page ground. */
    --ha-page-ground:   {{ settings.ha_page_ground   | default: '#F2EFE9' }};
    --ha-field-dark:    {{ settings.ha_field_dark    | default: '#332820' }};
    --ha-field-white:   {{ settings.ha_page_ground   | default: '#F2EFE9' }};
    --ha-field-botanical: var(--ha-loden-moss);
    --ha-field-blush:   var(--ha-bare-clay);
    --ha-field-slate:   var(--ha-inkstone);

    /* --- tint system (100 / 66 / 33 / 0 against white) --- */
    --ha-soot-66: rgb({{ soot_r | times: 0.66 | plus: 86.7 | round }}, {{ soot_g | times: 0.66 | plus: 86.7 | round }}, {{ soot_b | times: 0.66 | plus: 86.7 | round }});
    --ha-soot-33: rgb({{ soot_r | times: 0.33 | plus: 170.85 | round }}, {{ soot_g | times: 0.33 | plus: 170.85 | round }}, {{ soot_b | times: 0.33 | plus: 170.85 | round }});
    --ha-peat-66: rgb({{ peat_r | times: 0.66 | plus: 86.7 | round }}, {{ peat_g | times: 0.66 | plus: 86.7 | round }}, {{ peat_b | times: 0.66 | plus: 86.7 | round }});
    --ha-peat-33: rgb({{ peat_r | times: 0.33 | plus: 170.85 | round }}, {{ peat_g | times: 0.33 | plus: 170.85 | round }}, {{ peat_b | times: 0.33 | plus: 170.85 | round }});

    /* Placeholder field. 72% peat is the lightest tint that still carries
       Chalk Blue label text at AA (5.1:1); the 66% tint measures 4.3:1. */
    --ha-peat-72: rgb({{ peat_r | times: 0.72 | plus: 71.4 | round }}, {{ peat_g | times: 0.72 | plus: 71.4 | round }}, {{ peat_b | times: 0.72 | plus: 71.4 | round }});

    /* --- semantic roles: sections use THESE, never a colour name --- */
    --ha-text:        var(--ha-soot-black);
    --ha-text-quiet:  var(--ha-soot-66);
    --ha-text-invert: var(--ha-chalk-blue);

    /* Two rule weights, measured off Wireframe 04.

       The quiet hairline that carries the record tables, the accordion rows and
       the header measures #E0DEDC on the page ground and #453B33 on the peat
       field — the same 14% of the ink in both cases. So it is declared as an
       ALPHA rather than as a tint: one value that stays correct on five
       different fields, where a fixed tint would go muddy on four of them.
       .ha-section--dark re-declares it against Chalk Blue.

       The structural border — the size buttons — is near-solid ink and is a
       separate token, because the two are not interchangeable: the size a
       visitor is choosing must not be drawn in table-rule grey. */
    --ha-rule:   rgba({{ soot_r }}, {{ soot_g }}, {{ soot_b }}, 0.14);
    --ha-border: rgba({{ soot_r }}, {{ soot_g }}, {{ soot_b }}, 0.85);

    /* Accent colours fail WCAG AA as text (Mordant Amber 2.35:1, Loden Moss 2.36:1
       against white). They are surfaces, rules and marks only — never body copy,
       link text or button labels. */
    --ha-accent-surface: var(--ha-mordant-amber);
    --ha-botanical:      var(--ha-loden-moss);

    /* Provisional imagery, until Angela's assets land. */
    --ha-placeholder-field: var(--ha-peat-72);

    /* ==================================================================
       IMAGE RESTRAINT  —  Aloha, 4 September 2026
       "In a few sections, the images feel oversized for the space, which
        makes them dominate the layout. Images are important for us, but they
        shouldn't overwhelm the page. […] The Handcrafted Modern site is a
        good reference for proportion and how imagery supports the page
        without taking over."

       One ceiling, expressed against the viewport rather than in pixels, so
       the restraint holds on a 13" laptop and on a 27" monitor alike. A
       picture that cannot exceed roughly half the screen can support a page;
       one that fills the screen becomes the page.

       Every large figure on the product page reads this. Held as a setting
       because Aloha is re-editing the photographs after Monday's meeting with
       Angela and will want to retune once the real crops land.
       ================================================================== */
    --ha-media-cap: {{ settings.ha_media_cap | default: 56 }}vh;

    /* ==================================================================
       TYPE SCALE  —  Aloha, 3 September 2026
       "The typography currently feels too large and visually dense […]
        Too many elements have similar visual weight."

       --- RETUNED 4 SEPTEMBER 2026, AGAINST BODE ---------------------------
       Aloha: "Their text sizing is much easier to read and scan […] I want all
       the text on the website to have the same size text as Bode's."

       Bode set essentially their whole product page at 12px — product name,
       price, description, sizes, Add to bag, navigation. The largest text
       anywhere on that page is 16px, and the <h1> is visually hidden. Copying
       that PIXEL value would not copy what the eye sees. Measured off the font
       files themselves rather than guessed:

           Neue Haas Unica (Bode)      x-height 0.508 em
           Junicode        (narrate)   x-height 0.415 em
           Noto Mono Cond  (record)    x-height 0.536 em
           Porter          (identify)  cap-height 0.700 em

       Junicode is an old-style serif and reads about a fifth smaller than
       Unica at the same nominal size. Apparent parity with Bode's 12px is
       therefore 15px of Junicode and 12px of Noto, and that is what these
       defaults now are — the record voice matches at Bode's own number because
       it is already a sans of similar proportion.

       The display sizes are cut hard but not all the way to 12px. Bode carry
       hierarchy with weight and position and have no display typography at
       all; Hartwick's brand book has an editorial voice that would be deleted,
       not reduced, by a literal match. Both display sliders now reach 12px, so
       that decision stays Aloha's and needs no developer to reverse.

       Her stated hierarchy, held as tokens rather than as numbers scattered
       through CSS, so the whole site can be re-tuned from
       Theme settings > Hartwick — Material Archive > Type scale. She asked for
       these to be treated as starting points, so they have to be adjustable
       without a developer.

       Mobile first; the desktop values take over at 990px, Luxe's own
       breakpoint. Sizes are rem against Luxe's 10px root (1.6rem = 16px) so a
       visitor who has raised their browser's default text size still gets it.

       Aloha's floor: labels and technical information never below 12px on
       mobile. `at_least: 12` enforces it here, so the slider cannot break it.
       ================================================================== */
    --ha-t-style:      {{ settings.ha_t_style_m      | default: 22 | divided_by: 10.0 }}rem;
    --ha-t-expression: {{ settings.ha_t_expression_m | default: 15 | divided_by: 10.0 }}rem;
    --ha-t-body:       {{ settings.ha_t_body_m       | default: 15 | divided_by: 10.0 }}rem;
    --ha-t-body-lh:    {{ settings.ha_t_body_lh_m    | default: 24 | divided_by: 10.0 }}rem;
    --ha-t-price:      {{ settings.ha_t_price_m      | default: 15 | divided_by: 10.0 }}rem;
    --ha-t-label:      {{ settings.ha_t_label_m      | default: 12 | at_least: 12 | divided_by: 10.0 }}rem;
    --ha-t-meta:       {{ settings.ha_t_meta_m       | default: 12 | at_least: 12 | divided_by: 10.0 }}rem;
    --ha-t-ui:         {{ settings.ha_t_ui_m         | default: 12 | at_least: 12 | divided_by: 10.0 }}rem;
    --ha-t-editorial:  {{ settings.ha_t_editorial_m  | default: 24 | divided_by: 10.0 }}rem;

    /* One size between the editorial heading and body copy, for the two places
       the revised design sets a single sentence as a statement in its own right:
       the process line and the wearer's quotation. Wireframe 04 measures both
       at 32px on desktop. */
    --ha-t-statement:  {{ settings.ha_t_statement_m  | default: 18 | divided_by: 10.0 }}rem;

    /* Tracking travels with size: the record voice needs it, a 40px display
       heading does not. Declared here so a section never invents its own. */
    --ha-track-meta:  0.14em;
    --ha-track-label: 0.12em;
    --ha-track-ui:    0.14em;
  }

  @media screen and (min-width: 990px) {
    :root {
      --ha-t-style:      {{ settings.ha_t_style_d      | default: 26 | divided_by: 10.0 }}rem;
      --ha-t-expression: {{ settings.ha_t_expression_d | default: 15 | divided_by: 10.0 }}rem;
      --ha-t-body:       {{ settings.ha_t_body_d       | default: 15 | divided_by: 10.0 }}rem;
      --ha-t-body-lh:    {{ settings.ha_t_body_lh_d    | default: 24 | divided_by: 10.0 }}rem;
      --ha-t-price:      {{ settings.ha_t_price_d      | default: 15 | divided_by: 10.0 }}rem;
      --ha-t-label:      {{ settings.ha_t_label_d      | default: 12 | divided_by: 10.0 }}rem;
      --ha-t-meta:       {{ settings.ha_t_meta_d       | default: 12 | divided_by: 10.0 }}rem;
      --ha-t-ui:         {{ settings.ha_t_ui_d         | default: 12 | divided_by: 10.0 }}rem;
      --ha-t-editorial:  {{ settings.ha_t_editorial_d  | default: 32 | divided_by: 10.0 }}rem;
      --ha-t-statement:  {{ settings.ha_t_statement_d  | default: 21 | divided_by: 10.0 }}rem;
    }
  }
{% endstyle %}
