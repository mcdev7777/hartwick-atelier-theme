{%- comment -%}
  Hartwick Atelier — THE MATERIAL RECORD (shared component).

  Used twice:
    · homepage  — sections/ha-featured-lot.liquid (the short record: five rows)
    · product   — sections/main-product.liquid, Phase 1 Day 4 (full: true, all rows)

  Luxe's native `product_specifications` block cannot do this. It splits
  product.description on the literal string SPECIFICATIONS
  (sections/main-product.liquid) and never reads a metafield, so a structured
  record has to be its own component. See docs/audit-and-plan.md §C.

  Data comes from hartwick.* metafields (docs/data-model.md §3). Every row renders
  only when its field is present — an empty field collapses with no orphaned label
  and no gap (mobile brief §5). With no product bound, the wireframe's own
  placeholder strings render instead and the section shows the placeholder notice.

  Terminology: the Lot is customer-facing as a Roman numeral (LOT I), per
  Framework v3. The wireframe's "LOT 001" is superseded — flagged to Aloha.

  PRODUCTION QUANTITY, not "Edition". Aloha, 3 September 2026: "Where a
  production quantity is useful, it can appear factually within the Material
  Record, for example: Production quantity: 25 pieces. This should only be used
  when the number has been verified."

  So the old "Edition — 25 per size" row is gone, and its replacement is gated
  on `hartwick.production_quantity_verified`. An unverified number does not
  render at all: a quantity nobody has confirmed is exactly the kind of claim
  CLAUDE.md forbids inventing, and it is one small step from the scarcity
  language Aloha has just removed from the site.

  The Edition row only ever appears for a genuinely individually numbered
  garment — same test as snippets/ha-pdp-identity.liquid.

  Usage:
    {% render 'ha-material-record', product: product, full: true %}
    {% render 'ha-material-record', product: section.settings.product,
         ph_title: section.settings.title, ph_fibre: ... %}

  On the product page the Lot, Style and Expression are already stated at the top
  of the buy column, so the record renders the table alone:
    {% render 'ha-material-record', product: product, full: true,
         hide_eyebrow: true, hide_title: true, hide_intro: true %}
{%- endcomment -%}

{%- liquid
  assign mf = nil
  if product != blank
    assign mf = product.metafields.hartwick
  endif

  # --- eyebrow: LOT I · EDITION 07 / 25 ---------------------------------
  assign lot_label = ''
  if mf.lot.value.number_roman != blank
    assign lot_label = 'Lot ' | append: mf.lot.value.number_roman
  elsif ph_lot != blank
    assign lot_label = ph_lot
  endif

  assign edition_label = ''
  if mf.individually_numbered == true and mf.edition_number != blank and mf.edition_size != blank
    assign edition_label = 'Edition ' | append: mf.edition_number | append: ' / ' | append: mf.edition_size
  endif

  # --- title: the Style's display name, never a legacy name --------------
  assign record_title = ph_title
  if mf.style.value.display_name != blank
    assign record_title = mf.style.value.display_name
  elsif product != blank
    assign record_title = product.title
  endif

  assign record_intro = ph_intro
  if mf.expression != blank
    assign record_intro = mf.expression
  endif

  # --- rows ---------------------------------------------------------------
  assign r_fibre = mf.fibre | default: ph_fibre
  assign r_colour = mf.colour_name | default: ph_colour

  assign r_made_by = ph_made_by
  if mf.place_of_construction.value.place != blank
    assign r_made_by = 'The Masters, ' | append: mf.place_of_construction.value.place
  endif

  # A run size is a production fact and prints as one, once someone has checked
  # it. `ph_edition` is no longer a fallback — a placeholder quantity is a
  # number the visitor would read as verified.
  assign r_quantity = ''
  if mf.production_quantity_verified == true and mf.production_quantity != blank
    assign r_quantity = mf.production_quantity | append: ' pieces'
  endif

  # Shown only where each garment is individually numbered.
  assign r_edition = ''
  if mf.individually_numbered == true and mf.edition_number != blank and mf.edition_size != blank
    assign r_edition = mf.edition_number | append: ' of ' | append: mf.edition_size
  endif

  assign r_availability = mf.availability_note | default: ph_availability

  # --- the deeper rows, shown only when full: true (mobile brief §5) --------
  assign r_yarn = mf.yarn | default: ph_yarn
  assign r_weave = mf.weave | default: ph_weave

  assign r_weight = ph_weight
  if mf.weight_gsm != blank
    assign r_weight = mf.weight_gsm | append: ' gsm'
  endif

  assign r_dye = mf.dye.value.name | default: ph_dye
  assign r_woven = mf.place_of_weaving.value.place | default: ph_woven
  assign r_dyed = mf.place_of_dyeing.value.place | default: ph_dyed
  assign r_finishing = mf.finishing | default: ph_finishing
-%}

<div class="ha-record-block">
  {%- unless hide_eyebrow -%}
    {%- if lot_label != blank or edition_label != blank -%}
      <p class="ha-record__eyebrow ha-record">
        {{- lot_label -}}
        {%- if lot_label != blank and edition_label != blank %} &middot; {% endif -%}
        {{- edition_label -}}
      </p>
    {%- endif -%}
  {%- endunless -%}

  {%- unless hide_title -%}
    {%- if record_title != blank -%}
      <h2 class="ha-record__title ha-identify">{{ record_title }}</h2>
    {%- endif -%}
  {%- endunless -%}

  {%- unless hide_intro -%}
    {%- if record_intro != blank -%}
      <div class="ha-record__intro ha-body ha-narrate">{{ record_intro }}</div>
    {%- endif -%}
  {%- endunless -%}

  <table class="ha-record__table ha-record">
    <caption class="visually-hidden">The material record</caption>
    <tbody>
      {%- if r_fibre != blank -%}
        <tr><th scope="row">Fibre</th><td>{{ r_fibre }}</td></tr>
      {%- endif -%}
      {%- if full and r_yarn != blank -%}
        <tr><th scope="row">Yarn</th><td>{{ r_yarn }}</td></tr>
      {%- endif -%}
      {%- if full and r_weave != blank -%}
        <tr><th scope="row">Weave</th><td>{{ r_weave }}</td></tr>
      {%- endif -%}
      {%- if full and r_weight != blank -%}
        <tr><th scope="row">Weight</th><td>{{ r_weight }}</td></tr>
      {%- endif -%}
      {%- if r_colour != blank -%}
        <tr><th scope="row">Colour</th><td>{{ r_colour }}</td></tr>
      {%- endif -%}
      {%- if full and r_dye != blank -%}
        <tr><th scope="row">Dye</th><td>{{ r_dye }}</td></tr>
      {%- endif -%}
      {%- if full and r_woven != blank -%}
        <tr><th scope="row">Woven in</th><td>{{ r_woven }}</td></tr>
      {%- endif -%}
      {%- if full and r_dyed != blank -%}
        <tr><th scope="row">Dyed in</th><td>{{ r_dyed }}</td></tr>
      {%- endif -%}
      {%- if r_made_by != blank -%}
        <tr><th scope="row">Made by</th><td>{{ r_made_by }}</td></tr>
      {%- endif -%}
      {%- if full and r_finishing != blank -%}
        <tr><th scope="row">Finishing</th><td>{{ r_finishing }}</td></tr>
      {%- endif -%}
      {%- comment -%}
        The Lot. Aloha, 3 Sep 2026: with the Edition removed, "the opening label
        should simply show the confirmed Lot information" — so the Lot has to be
        stated somewhere, and Wireframe 04 puts it here as the closing row of the
        record. Customer-facing as a Roman numeral (Framework v3).
      {%- endcomment -%}
      {%- if lot_label != blank -%}
        <tr><th scope="row">Lot</th><td>{{ lot_label }}</td></tr>
      {%- endif -%}
      {%- if r_quantity != blank -%}
        <tr><th scope="row">Production quantity</th><td>{{ r_quantity }}</td></tr>
      {%- endif -%}
      {%- if r_edition != blank -%}
        <tr><th scope="row">Edition</th><td>{{ r_edition }}</td></tr>
      {%- endif -%}
      {%- if r_availability != blank -%}
        <tr><th scope="row">Availability</th><td>{{ r_availability }}</td></tr>
      {%- endif -%}
    </tbody>
  </table>

  {%- if link_text != blank -%}
    <a class="ha-record__link ha-identify" href="{{ link_url | default: '#' }}">{{ link_text }}</a>
  {%- endif -%}
</div>
