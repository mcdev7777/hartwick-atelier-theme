            "master_url": ""
          }
        },
        "t_block_printed_by_hand": {
          "type": "technique",
          "settings": {
            "key": "block-printed-by-hand",
            "number": "04",
            "title": "Block printed by hand",
            "summary": "Pattern built by hand, layer by layer, colour by colour.",
            "tagline": "Layer by layer, colour by colour",
            "body": "<p>The printer places a carved wooden block onto the cloth, then repeats the impression to build the pattern. Each colour is applied in its own pass. Small variations in placement and colour are part of this hand process.</p>",
            "image": "shopify://shop_images/HARTWICK_MASTERS_BLOCK_FACE_4R1A4565.jpg",
            "alt": "The raised printing face of a carved wooden block",
            "caption": "",
            "film_title": "",
            "transcript": "",
