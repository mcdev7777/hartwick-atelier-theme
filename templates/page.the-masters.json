            "key": "khadi",
            "number": "01",
            "title": "Khadi",
            "summary": "Handspun and handwoven natural-fibre cloth.",
            "tagline": "Handspun and handwoven",
            "body": "<p>Khadi is cloth made from yarn spun by hand and woven on a handloom. Spinning and weaving both shape its character. Small variations in the yarn and weave record the work of the hands that made it.</p>",
            "image": "shopify://shop_images/HARTWICK_MASTERS_WEAVER_AT_LOOM_4R1A4504.jpg",
            "alt": "A Master at work beside the handloom",
            "caption": "",
