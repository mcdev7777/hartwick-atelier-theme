            "master_url": ""
          }
        },
        "t_ajrakh": {
          "type": "technique",
          "settings": {
            "key": "ajrakh",
            "number": "07",
            "title": "Ajrakh",
            "summary": "Resist printing, dyeing, washing and time.",
            "tagline": "Printing, dyeing, washing and rest",
            "body": "<p>Ajrakh combines carved-block printing and resist-dyeing processes. Patterns are built through successive stages, with washing and resting between parts of the work. The archive shows colour preparation, printing and cloth drying outdoors: different moments within one extended process.</p>",
            "alt": "",
            "caption": "",
            "film_title": "",
            "transcript": "",
