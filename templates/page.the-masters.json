        },
        "t_hand_spun": {
          "type": "technique",
          "settings": {
            "key": "hand-spun",
            "number": "02",
            "title": "Hand spun",
            "summary": "Natural fibres drawn out and twisted into yarn.",
            "tagline": "From fibre to yarn",
            "body": "<p>Natural fibres are drawn out and twisted together by hand to form a yarn. The spinner controls the thickness and twist as the fibre passes through their fingers. The yarn is then prepared for weaving.</p>",
            "image": "shopify://shop_images/HARTWICK_MASTERS_CHARKHA_4R1A4460.jpg",
            "alt": "A charkha, the spinning wheel, standing in the yard",
            "caption": "",
            "film_title": "",
