    "rich_text_TpFMjm": {
      "type": "rich-text",
      "blocks": {
        "image_Mf46UJ": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/Hartwick_logo_PlainFrame_Square.jpg",
